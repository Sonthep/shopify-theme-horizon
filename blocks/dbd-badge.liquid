<div class="footer-dbd-badge" aria-hidden="false">
  {% assign dbd_image_setting = block.settings.dbd_image %}
  {% if dbd_image_setting == blank %}
    {% assign dbd_src = 'dbd-registered.svg' | asset_url %}
  {% else %}
    {% assign dbd_src = dbd_image_setting | image_url %}
  {% endif %}
  {% assign dbd_width = block.settings.dbd_width | default: 90 %}
  {% assign dbd_link = block.settings.dbd_link | default: '' %}
  {% if dbd_link != blank %}
    <a href="{{ dbd_link }}" class="footer-dbd-link" target="_blank" rel="noopener">
      <img src="{{ dbd_src }}" alt="DBD Registered" class="footer-dbd-img" style="width: {{ dbd_width }}px; height: auto;" />
    </a>
  {% else %}
    <img src="{{ dbd_src }}" alt="DBD Registered" class="footer-dbd-img" style="width: {{ dbd_width }}px; height: auto;" />
  {% endif %}
</div>

{% stylesheet %}
.footer-dbd-badge {
  display: flex;
  justify-content: flex-start;
  align-items: center;
  width: 100%;
  margin-top: 12px;
}
.footer-dbd-img {
  max-width: 100%;
  height: auto;
  display: block;
}
@media screen and (max-width: 749px) {
  .footer-dbd-badge {
    justify-content: center;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "DBD Badge",
  "settings": [
    {
      "type": "image_picker",
      "id": "dbd_image",
      "label": "DBD image (optional)"
    },
    {
      "type": "url",
      "id": "dbd_link",
      "label": "DBD link (optional)"
    },
    {
      "type": "range",
      "id": "dbd_width",
      "label": "Image width (px)",
      "min": 40,
      "max": 300,
      "step": 5,
      "default": 90
    }
  ],
  "presets": [
    {
      "name": "DBD Badge"
    }
  ]
}
{% endschema %}
