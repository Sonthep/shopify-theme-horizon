{%- doc -%}
  Renders the request-quotation control under the cart checkout buttons.
  Signed-in customers preview and download a PDF quotation of the current cart from the
  quotation app proxy, which reads the cart and customer from Shopify itself.
  Guests get a login link instead. Controlled by the `cart_quote_*` theme settings.

  @param {boolean} [primary] - Styles the control as the main cart action when it replaces checkout.

  @example
  {% render 'cart-quote', primary: true %}
{%- enddoc -%}

{%- if settings.cart_quote_enabled and cart != empty -%}
  {%- if customer -%}
    <script
      type="module"
      src="{{ 'cart-quote.js' | asset_url }}"
    ></script>

    <cart-quote
      class="cart-quote"
      data-endpoint="/apps/quotation/cart-quote"
      data-payment-term="{{ settings.cart_quote_payment_term | escape }}"
      data-validity-days="{{ settings.cart_quote_validity_days }}"
      data-remark="{{ settings.cart_quote_remark | escape }}"
      data-message-preparing="{{ 'content.cart_quote_preparing' | t }}"
      data-message-ready="{{ 'content.cart_quote_ready' | t: number: '[number]' }}"
      data-message-error="{{ 'content.cart_quote_error' | t }}"
      data-message-error-cart="{{ 'content.cart_quote_error_cart' | t }}"
      data-message-error-login="{{ 'content.cart_quote_error_login' | t }}"
      data-message-error-rate="{{ 'content.cart_quote_error_rate' | t }}"
    >
      <button
        type="button"
        class="button{% unless primary %} button-secondary{% endunless %} cart-quote__button"
        ref="button"
        on:click="/requestQuote"
      >
        {{ 'content.cart_quote_request' | t }}
      </button>
      <p
        class="cart-quote__status cart-primary-typography"
        ref="status"
        role="status"
      ></p>
      <dialog
        class="cart-quote__dialog"
        ref="dialog"
        aria-label="{{ 'content.cart_quote_preview_title' | t }}"
      >
        <div class="cart-quote__dialog-header">
          <h2
            class="cart-quote__dialog-title"
            ref="title"
          >
            {{- 'content.cart_quote_preview_title' | t -}}
          </h2>
          <button
            type="button"
            class="button button-unstyled cart-quote__close"
            on:click="/closePreview"
          >
            <span
              class="svg-wrapper"
              aria-hidden="true"
            >
              {{- 'icon-close.svg' | inline_asset_content -}}
            </span>
            <span class="visually-hidden">{{ 'accessibility.close_dialog' | t }}</span>
          </button>
        </div>
        <iframe
          class="cart-quote__frame"
          ref="frame"
          title="{{ 'content.cart_quote_preview_title' | t }}"
        ></iframe>
        <div class="cart-quote__actions">
          <a
            class="button cart-quote__action"
            ref="downloadLink"
            href="#"
          >
            {{- 'content.quote_images_download' | t -}}
          </a>
          <a
            class="button button-secondary cart-quote__action"
            ref="openLink"
            href="#"
            target="_blank"
            rel="noopener"
          >
            {{- 'content.quote_images_open' | t -}}
          </a>
        </div>
      </dialog>
    </cart-quote>
  {%- elsif shop.customer_accounts_enabled -%}
    {%- assign login_url = routes.account_login_url | append: '?return_url=' | append: routes.cart_url -%}
    {%- if primary -%}
      <a
        href="{{ login_url }}"
        class="button cart-quote__button"
      >
        {{ 'content.cart_quote_login' | t }}
      </a>
    {%- else -%}
      <p class="cart-quote__login cart-primary-typography">
        {{ 'content.cart_quote_login_html' | t: link: login_url }}
      </p>
    {%- endif -%}
  {%- endif -%}
{%- endif -%}

{% stylesheet %}
  .cart-quote {
    display: grid;
    gap: var(--gap-2xs);
    min-width: 0;
  }

  .cart-quote__button {
    width: 100%;
    height: clamp(25px, var(--height-buy-buttons), 55px);
    padding-inline: var(--padding-4xl);
  }

  .cart-quote__button[aria-busy='true'] {
    cursor: progress;
  }

  .cart-quote__status:empty {
    display: none;
  }

  .cart-quote__status,
  .cart-quote__login {
    margin: 0;
    font-size: var(--font-size--xs);
    text-align: center;
    overflow-wrap: anywhere;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
  }

  .cart-quote__login a {
    color: var(--color-foreground);
  }

  .cart-quote__dialog {
    inline-size: min(60rem, calc(100vw - 2rem));
    max-inline-size: none;
    block-size: min(90dvh, 70rem);
    max-block-size: none;
    padding: var(--padding-lg);
    border: var(--style-border-width) solid rgb(var(--color-foreground-rgb) / var(--opacity-10));
    color: var(--color-foreground);
    background: var(--color-background);
  }

  .cart-quote__dialog[open] {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    gap: var(--gap-sm);
  }

  .cart-quote__dialog::backdrop {
    background: rgb(0 0 0 / 0.5);
  }

  .cart-quote__dialog-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-sm);
    min-width: 0;
  }

  .cart-quote__dialog-title {
    margin: 0;
    font-size: var(--font-size--md);
    overflow-wrap: anywhere;
  }

  .cart-quote__close {
    display: inline-flex;
    flex-shrink: 0;
    padding: var(--padding-xs);
    color: var(--color-foreground);
  }

  .cart-quote__frame {
    inline-size: 100%;
    block-size: 100%;
    border: var(--style-border-width) solid rgb(var(--color-foreground-rgb) / var(--opacity-10));
  }

  .cart-quote__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-sm);
    justify-content: center;
  }
{% endstylesheet %}
