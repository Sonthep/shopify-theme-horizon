{% comment %}
  Section contract.
  Returns predictive search products as JSON for the bulk order page, with each variant's SKU, price
  and tracked stock, which the predictive search JSON leaves out. Shaped like the product JSON at
  /products/<handle>.js so assets/bulk-order.js treats both alike. Not added to templates.
  Bulk order is for signed-in customers, so guests get an empty list and can't read stock here.
  @example
  <!-- Fetched by assets/product-lookup.js searchProductDetails():
       /search/suggest?q=mixer&resources[type]=product&section_id=bulk-order-results -->
{% endcomment %}

{%- capture results -%}
  [
  {%- if customer -%}
  {%- for product in predictive_search.resources.products -%}
    {%- liquid
      assign image = product.featured_media.preview_image
      assign body = product.description | strip_html | strip_newlines | truncate: 800
    -%}
    {
    "title": {{ product.title | json }},
    "url": {{ product.url | json }},
    "handle": {{ product.handle | json }},
    "vendor": {{ product.vendor | json }},
    "type": {{ product.type | json }},
    "tags": {{ product.tags | json }},
    "body": {{ body | json }},
    "featured_image": {% if image %}{{ image | image_url: width: 192 | json }}{% else %}null{% endif %},
    "variants": [
    {%- for variant in product.variants -%}
      {
      "id": {{ variant.id | json }},
      "title": {{ variant.title | json }},
      "sku": {{ variant.sku | default: '' | json }},
      "price": {{ variant.price | json }},
      "available": {{ variant.available | json }},
      {%- # Only Shopify-tracked stock has a meaningful count; untracked variants report none. -%}
      "stock": {% if variant.inventory_management == 'shopify' %}{{ variant.inventory_quantity | json }}{% else %}null{% endif %},
      "featured_image": {% if variant.featured_image %}{ "src": {{ variant.featured_image | image_url: width: 192 | json }} }{% else %}null{% endif %}
      }
      {%- unless forloop.last %},{% endunless -%}
    {%- endfor -%}
    ]
    }
    {%- unless forloop.last %},{% endunless -%}
  {%- endfor -%}
  {%- endif -%}
  ]
{%- endcapture -%}

<div
  hidden
  data-results="{{ results | escape }}"
></div>

{% schema %}
{
  "name": "t:names.bulk_order"
}
{% endschema %}
