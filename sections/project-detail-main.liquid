{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .project-detail-main {
    background-color: #FFFFFF;
  }

  .project-detail-main__inner {
    max-width: var(--page-width, 1440px);
    margin: 0 auto;
    padding-left: 2rem;
    padding-right: 2rem;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  @media screen and (min-width: 990px) {
    .project-detail-main__inner {
      display: grid;
      grid-template-columns: 1fr 380px;
      gap: 64px;
      align-items: start;
    }
  }

  .project-detail-column {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  /* Block: Overview */
  .block-overview__heading {
    font-size: 24px;
    line-height: 32px;
    font-weight: 600;
    color: #123B2B;
    margin: 0 0 16px 0;
    font-family: var(--font-heading-family);
  }
  .block-overview__text {
    font-size: 16px;
    line-height: 24px;
    color: #5E6A63;
  }
  .block-overview__text p {
    margin-top: 0;
    margin-bottom: 16px;
  }

  /* Block: Equipment */
  .block-equipment__heading {
    font-size: 24px;
    line-height: 32px;
    font-weight: 600;
    color: #123B2B;
    margin: 0 0 16px 0;
    font-family: var(--font-heading-family);
  }
  .block-equipment__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }
  @media screen and (min-width: 750px) {
    .block-equipment__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .equipment-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px;
    border: 1px solid #D9E3DD;
    border-radius: 12px;
    background-color: #FFFFFF;
  }
  .equipment-card__image {
    width: 48px;
    height: 48px;
    background-color: #F3F8F5;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .equipment-card__image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .equipment-card__info {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .equipment-card__name {
    font-size: 14px;
    font-weight: 600;
    color: #1C1F1D;
    margin: 0;
  }
  .equipment-card__serial {
    font-size: 12px;
    color: #5E6A63;
    margin: 0;
  }
  .equipment-card__status {
    font-size: 10px;
    font-weight: 600;
    padding: 4px 8px;
    border-radius: 100px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .equipment-card__status--active {
    background-color: #E8F5E9;
    color: #1F6B4D;
  }
  .equipment-card__status--standby {
    background-color: #F5F5F5;
    color: #5E6A63;
  }

  /* Block: Gallery */
  .block-gallery__heading {
    font-size: 24px;
    line-height: 32px;
    font-weight: 600;
    color: #123B2B;
    margin: 0 0 16px 0;
    font-family: var(--font-heading-family);
  }
  .block-gallery__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .block-gallery__item {
    border-radius: 8px;
    overflow: hidden;
    position: relative;
    padding-bottom: 75%; /* Default aspect ratio */
  }
  .block-gallery__item img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  @media screen and (min-width: 750px) {
    .block-gallery__grid {
      grid-template-columns: 3fr 1fr;
      grid-template-rows: repeat(4, 1fr);
      gap: 12px;
    }
    .block-gallery__item {
      padding-bottom: 0; /* reset padding hack */
      border-radius: 12px;
    }
    .block-gallery__item:nth-child(1) {
      grid-column: 1;
      grid-row: 1 / span 4;
      aspect-ratio: auto;
      height: 100%;
    }
    .block-gallery__item:nth-child(n+2) {
      grid-column: 2;
      aspect-ratio: 4/3;
      height: 100%;
    }
  }

  /* Block: Video */
  .block-video__heading {
    font-size: 24px;
    line-height: 32px;
    font-weight: 600;
    color: #123B2B;
    margin: 0 0 16px 0;
    font-family: var(--font-heading-family);
  }
  .block-video__wrapper {
    position: relative;
    padding-bottom: 56.25%; /* 16:9 Aspect Ratio */
    border-radius: 12px;
    overflow: hidden;
    background: #000;
  }
  .block-video__wrapper iframe,
  .block-video__wrapper video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Block: Technical Summary */
  .block-tech-summary {
    background-color: #2D373B; /* Dark grayish-blue from design */
    border-radius: 12px;
    padding: 24px;
    color: #FFFFFF;
  }
  .block-tech-summary__heading {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #27AE60;
    margin: 0 0 24px 0;
  }
  .block-tech-summary__list {
    display: flex;
    flex-direction: column;
  }
  .block-tech-summary__row {
    display: grid;
    grid-template-columns: 130px 1fr;
    align-items: baseline;
    gap: 12px;
    padding: 14px 0;
    border-bottom: 1px solid rgba(255,255,255,0.1);
    font-size: 14px;
  }
  .block-tech-summary__row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  .block-tech-summary__label {
    color: #A0ABA5;
    line-height: 1.5;
  }
  .block-tech-summary__value {
    font-weight: 600;
    color: #FFFFFF;
    text-align: left;
    line-height: 1.5;
  }
  .block-tech-summary__value--highlight {
    color: #27AE60;
  }

  /* Block: Testimonial */
  .block-testimonial {
    background-color: #F3F8F5;
    border-radius: 12px;
    padding: 24px;
    position: relative;
  }
  .block-testimonial__quote-icon {
    position: absolute;
    top: 24px;
    right: 24px;
    font-size: 48px;
    line-height: 1;
    color: #D1E5DB;
    font-family: serif;
  }
  .block-testimonial__header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }
  .block-testimonial__image {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    overflow: hidden;
  }
  .block-testimonial__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .block-testimonial__author-info {
    display: flex;
    flex-direction: column;
  }
  .block-testimonial__name {
    font-size: 14px;
    font-weight: 600;
    color: #123B2B;
    margin: 0;
  }
  .block-testimonial__role {
    font-size: 10px;
    color: #5E6A63;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin: 0;
  }
  .block-testimonial__text {
    font-size: 14px;
    line-height: 22px;
    color: #1C1F1D;
    font-style: italic;
    margin: 0;
    position: relative;
    z-index: 1;
  }

  /* Block: Location */
  .block-location__heading {
    font-size: 20px;
    line-height: 28px;
    font-weight: 600;
    color: #123B2B;
    margin: 0 0 16px 0;
    font-family: var(--font-heading-family);
  }
  .block-location__map {
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid #D9E3DD;
    position: relative;
    padding-bottom: 50%; /* 2:1 aspect ratio */
  }
  .block-location__map img,
  .block-location__map iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: none;
  }
  .block-location__pin {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }
  .block-location__pin svg {
    width: 32px;
    height: 32px;
    fill: #1F6B4D;
  }
  .block-location__pin-text {
    background-color: #FFFFFF;
    padding: 4px 12px;
    border-radius: 100px;
    font-size: 12px;
    font-weight: 600;
    color: #123B2B;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  }

  /* Lightbox */
  .project-detail-lightbox {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 99999;
    display: none;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .project-detail-lightbox--active {
    display: flex;
    opacity: 1;
  }
  .project-detail-lightbox__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(18, 59, 43, 0.95);
    cursor: pointer;
  }
  .project-detail-lightbox__content {
    position: relative;
    z-index: 1;
    max-width: 90vw;
    max-height: 90vh;
  }
  .project-detail-lightbox__content img {
    max-width: 100%;
    max-height: 90vh;
    object-fit: contain;
    border-radius: 8px;
    box-shadow: 0 20px 40px rgba(0,0,0,0.3);
  }
  .project-detail-lightbox__close {
    position: absolute;
    top: 24px;
    right: 24px;
    z-index: 2;
    background: none;
    border: none;
    color: white;
    cursor: pointer;
    padding: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s;
  }
  .project-detail-lightbox__close:hover {
    transform: scale(1.1);
  }
  .project-detail-lightbox__close svg {
    width: 32px;
    height: 32px;
    fill: currentColor;
  }
  .project-detail-lightbox__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    background: rgba(0, 0, 0, 0.5);
    border: none;
    color: white;
    cursor: pointer;
    padding: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.2s, transform 0.2s;
    border-radius: 50%;
  }
  .project-detail-lightbox__nav:hover {
    background: rgba(0, 0, 0, 0.8);
    transform: translateY(-50%) scale(1.1);
  }
  .project-detail-lightbox__nav svg {
    width: 32px;
    height: 32px;
    fill: currentColor;
  }
  .project-detail-lightbox__nav--prev {
    left: 24px;
  }
  .project-detail-lightbox__nav--next {
    right: 24px;
  }
{%- endstyle -%}

<div class="project-detail-main section-{{ section.id }}-padding">
  <div class="project-detail-main__inner">
    
    <div class="project-detail-column project-detail-column--left">
      {%- for block in section.blocks -%}
        {%- if block.settings.column == 'left' -%}
          {%- render 'project-detail-block', block: block -%}
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="project-detail-column project-detail-column--right">
      {%- for block in section.blocks -%}
        {%- if block.settings.column == 'right' -%}
          {%- render 'project-detail-block', block: block -%}
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>
</div>

<div id="project-detail-lightbox" class="project-detail-lightbox">
  <div class="project-detail-lightbox__overlay"></div>
  <button class="project-detail-lightbox__close" aria-label="Close">
    <svg viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
  </button>
  <button class="project-detail-lightbox__nav project-detail-lightbox__nav--prev" aria-label="Previous">
    <svg viewBox="0 0 24 24"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
  </button>
  <button class="project-detail-lightbox__nav project-detail-lightbox__nav--next" aria-label="Next">
    <svg viewBox="0 0 24 24"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
  </button>
  <div class="project-detail-lightbox__content">
    <img id="project-detail-lightbox-img" src="" alt="Gallery Image Fullscreen">
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const galleryItems = document.querySelectorAll('.block-gallery__item');
    const lightbox = document.getElementById('project-detail-lightbox');
    
    if (!lightbox || galleryItems.length === 0) return;

    const lightboxImg = document.getElementById('project-detail-lightbox-img');
    const closeBtn = lightbox.querySelector('.project-detail-lightbox__close');
    const prevBtn = lightbox.querySelector('.project-detail-lightbox__nav--prev');
    const nextBtn = lightbox.querySelector('.project-detail-lightbox__nav--next');
    const overlay = lightbox.querySelector('.project-detail-lightbox__overlay');
    
    let currentIndex = 0;
    const images = [];

    // Extract all image sources
    galleryItems.forEach((item, index) => {
      const img = item.querySelector('img');
      if (img) {
        let src = img.getAttribute('src');
        src = src.replace(/_\d+x\d*(\.\w+(?:\?v=\d+)?)$/i, '$1'); 
        images.push(src);
        
        item.style.cursor = 'zoom-in';
        item.addEventListener('click', function() {
          openLightbox(index);
        });
      }
    });

    function openLightbox(index) {
      currentIndex = index;
      updateImage();
      lightbox.style.display = 'flex';
      setTimeout(() => {
        lightbox.classList.add('project-detail-lightbox--active');
      }, 10);
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      lightbox.classList.remove('project-detail-lightbox--active');
      document.body.style.overflow = '';
      setTimeout(() => { 
        lightbox.style.display = 'none';
        lightboxImg.src = ''; 
      }, 300);
    }
    
    function updateImage() {
      lightboxImg.src = images[currentIndex];
    }
    
    function showNext() {
      currentIndex = (currentIndex + 1) % images.length;
      updateImage();
    }
    
    function showPrev() {
      currentIndex = (currentIndex - 1 + images.length) % images.length;
      updateImage();
    }

    closeBtn.addEventListener('click', closeLightbox);
    overlay.addEventListener('click', closeLightbox);
    nextBtn.addEventListener('click', showNext);
    prevBtn.addEventListener('click', showPrev);
    
    document.addEventListener('keydown', function(e) {
      if (!lightbox.classList.contains('project-detail-lightbox--active')) return;
      
      if (e.key === 'Escape') {
        closeLightbox();
      } else if (e.key === 'ArrowRight') {
        showNext();
      } else if (e.key === 'ArrowLeft') {
        showPrev();
      }
    });
  });
</script>

