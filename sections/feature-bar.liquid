{{ 'feature-bar.css' | asset_url | stylesheet_tag }}

<div
  class="feature-bar color-{{ section.settings.color_scheme }} section spacing-style"
  style="{%- render 'spacing-style', settings: section.settings -%}"
>
  <div class="page-width">
    <div class="feature-bar__inner">
      <ul class="feature-bar__list" role="list">
      {%- for block in section.blocks -%}
        <li class="feature-bar__item" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="feature-bar__icon" aria-hidden="true">
              {{- block.settings.image | image_url: width: 120 | image_tag:
                  loading: 'lazy',
                  width: 60,
                  height: 60,
                  class: 'feature-bar__img',
                  alt: block.settings.title
              -}}
            </div>
          {%- endif -%}
          <div class="feature-bar__content">
            {%- if block.settings.title != blank -%}
              <p class="feature-bar__title">{{ block.settings.title | escape }}</p>
            {%- endif -%}
            {%- if block.settings.description != blank -%}
              <p class="feature-bar__description">{{ block.settings.description | escape }}</p>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Feature Bar",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 28
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Icon image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Feature Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Short feature description goes here."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature Bar",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "title": "Best Price Guarantee",
            "description": "Best value assured with exclusive special offers"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Large Stock",
            "description": "Over 50,000 items ready to meet all your needs"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Free Shipping",
            "description": "On orders over ฿5,000 to Bangkok, Phuket & Samui"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "After-Sales Service",
            "description": "Expert support & consultation 24 hours, 365 days"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Repair & Maintenance",
            "description": "Inspection and repairs by certified technicians"
          }
        }
      ]
    }
  ]
}
{% endschema %}
