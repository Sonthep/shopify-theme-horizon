{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .project-detail-hero {
    position: relative;
    overflow: hidden;
    min-height: 400px;
    display: flex;
    align-items: flex-end;
    background-color: #123B2B;
  }

  @media screen and (min-width: 750px) {
    .project-detail-hero {
      min-height: 500px;
    }
  }

  .project-detail-hero__bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .project-detail-hero__bg img,
  .project-detail-hero__bg svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-detail-hero__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to top, rgba(18, 59, 43, 0.9) 0%, rgba(18, 59, 43, 0.4) 50%, rgba(18, 59, 43, 0.1) 100%);
    z-index: 2;
  }

  .project-detail-hero__content {
    position: relative;
    z-index: 3;
    max-width: var(--page-width, 1440px);
    width: 100%;
    margin: 0 auto;
    padding-left: 2rem;
    padding-right: 2rem;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .project-detail-hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    background-color: rgba(18, 59, 43, 0.8);
    border: 1px solid #1F6B4D;
    border-radius: 4px;
    color: #FFFFFF;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    width: fit-content;
  }

  .project-detail-hero__badge svg {
    width: 14px;
    height: 14px;
    fill: #27AE60; /* Slightly brighter green for the check to pop */
  }

  .project-detail-hero__title {
    font-size: 40px;
    line-height: 1.2;
    font-weight: 600;
    color: #FFFFFF;
    margin: 0;
    font-family: var(--font-heading-family);
  }

  @media screen and (min-width: 750px) {
    .project-detail-hero__title {
      font-size: 64px;
      max-width: 800px;
    }
  }

  .project-detail-hero__meta-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 24px;
    margin-top: 8px;
  }

  .project-detail-hero__meta-item {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #D9E3DD;
    font-size: 14px;
    font-weight: 500;
  }

  .project-detail-hero__meta-item svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
{%- endstyle -%}

<div class="project-detail-hero section-{{ section.id }}-padding">
  <div class="project-detail-hero__bg">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2880 | image_tag: loading: 'eager', widths: '750, 1100, 1500, 2000, 2880' }}
    {%- elsif request.page_type == 'article' and article.image != blank -%}
      {{ article.image | image_url: width: 2880 | image_tag: loading: 'eager', widths: '750, 1100, 1500, 2000, 2880' }}
    {%- else -%}
      <img src="{{ 'mockup-hero.png' | asset_url }}" alt="Metropolitan Hotel Central Kitchen" loading="eager" fetchpriority="high" width="2880" height="1620">
    {%- endif -%}
  </div>
  <div class="project-detail-hero__overlay"></div>

  <div class="project-detail-hero__content">
    {%- if section.settings.badge_text != blank -%}
      <div class="project-detail-hero__badge">
        <svg viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path d="M10 20C4.477 20 0 15.523 0 10S4.477 0 10 0s10 4.477 10 10-4.477 10-10 10zm-1.026-6.49l6.59-6.59-1.414-1.414-5.176 5.176-2.586-2.586-1.414 1.414 4 4z" fill-rule="nonzero"/></svg>
        {{ section.settings.badge_text }}
      </div>
    {%- endif -%}

    <h1 class="project-detail-hero__title">
      {%- if request.page_type == 'page' and section.settings.use_page_title -%}
        {{ page.title }}
      {%- elsif request.page_type == 'article' and section.settings.use_page_title -%}
        {{ article.title }}
      {%- else -%}
        {{ section.settings.title }}
      {%- endif -%}
    </h1>
    
    <div class="project-detail-hero__meta-list">
      {%- if section.settings.location != blank -%}
        <div class="project-detail-hero__meta-item">
          <svg viewBox="0 0 24 24"><path d="M12 21s-8-7.5-8-12a8 8 0 1 1 16 0c0 4.5-8 12-8 12z"/><circle cx="12" cy="9" r="3"/></svg>
          {{ section.settings.location }}
        </div>
      {%- endif -%}
      {%- if section.settings.date != blank -%}
        <div class="project-detail-hero__meta-item">
          <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          {{ section.settings.date }}
        </div>
      {%- endif -%}
      {%- if section.settings.area != blank -%}
        <div class="project-detail-hero__meta-item">
          <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><path d="M9 3v18"/><path d="M15 3v18"/><path d="M3 9h18"/><path d="M3 15h18"/></svg>
          {{ section.settings.area }}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Project Detail Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Project Main Background Image"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "COMPLETED PROJECT"
    },
    {
      "type": "checkbox",
      "id": "use_page_title",
      "label": "Use page title as heading",
      "default": false
    },
    {
      "type": "text",
      "id": "title",
      "label": "Project Title",
      "info": "Used if 'Use page title' is unchecked or not on a page template",
      "default": "Metropolitan Hotel Central Kitchen"
    },
    {
      "type": "text",
      "id": "location",
      "label": "Location",
      "default": "London, UK"
    },
    {
      "type": "text",
      "id": "date",
      "label": "Date",
      "default": "Jan 2024"
    },
    {
      "type": "text",
      "id": "area",
      "label": "Area",
      "default": "4,500 SQFT"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "Top padding",
      "default": 160
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "Bottom padding",
      "default": 65
    }
  ],
  "presets": [
    {
      "name": "Project Detail Hero"
    }
  ]
}
{% endschema %}
