{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .landing-stats-bar {
    background-color: #111111;
  }

  .landing-stats-bar__inner {
    max-width: var(--page-width, 1440px);
    margin: 0 auto;
    padding-left: 2rem;
    padding-right: 2rem;
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 24px;
  }

  @media screen and (min-width: 750px) {
    .landing-stats-bar__inner {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (min-width: 1024px) {
    .landing-stats-bar__inner {
      grid-template-columns: repeat({{ section.blocks.size }}, 1fr);
      gap: 32px;
    }
  }

  .landing-stats-bar__item {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .landing-stats-bar__icon {
    width: 40px;
    height: 40px;
    color: #CCA876;
    flex-shrink: 0;
  }

  .landing-stats-bar__text-wrapper {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .landing-stats-bar__heading {
    font-size: 14px;
    font-weight: 600;
    color: #CCA876;
    line-height: 1.2;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .landing-stats-bar__subtext {
    font-size: 13px;
    color: #F3F8F5;
    line-height: 1.4;
    margin: 0;
  }

  /* Divider lines between items on desktop */
  @media screen and (min-width: 1024px) {
    .landing-stats-bar__item {
      position: relative;
      padding-right: 32px;
    }
    .landing-stats-bar__item:not(:last-child)::after {
      content: '';
      position: absolute;
      right: 0;
      top: 50%;
      transform: translateY(-50%);
      height: 40px;
      width: 1px;
      background-color: #333333;
    }
  }
{%- endstyle -%}

<div class="landing-stats-bar section-{{ section.id }}-padding">
  <div class="landing-stats-bar__inner">
    {%- for block in section.blocks -%}
      <div class="landing-stats-bar__item" {{ block.shopify_attributes }}>
        <div class="landing-stats-bar__icon">
          {%- if block.settings.icon != blank -%}
            {{ block.settings.icon }}
          {%- else -%}
            {%- if forloop.index == 1 -%}
              <!-- Shield Check (One Stop Service) -->
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                <path d="M9 12l2 2 4-4"/>
              </svg>
            {%- elsif forloop.index == 2 -%}
              <!-- Users (Professional Team) -->
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                <circle cx="9" cy="7" r="4"/>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
              </svg>
            {%- elsif forloop.index == 3 -%}
              <!-- Award (Premium Quality) -->
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="8" r="7"/>
                <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/>
              </svg>
            {%- elsif forloop.index == 4 -%}
              <!-- LifeBuoy (After Sales Service) -->
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <circle cx="12" cy="12" r="4"/>
                <line x1="4.93" y1="4.93" x2="9.17" y2="9.17"/>
                <line x1="14.83" y1="14.83" x2="19.07" y2="19.07"/>
                <line x1="14.83" y1="9.17" x2="19.07" y2="4.93"/>
                <line x1="4.93" y1="19.07" x2="9.17" y2="14.83"/>
              </svg>
            {%- else -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
              </svg>
            {%- endif -%}
          {%- endif -%}
        </div>
        <div class="landing-stats-bar__text-wrapper">
          <h3 class="landing-stats-bar__heading">{{ block.settings.heading | newline_to_br }}</h3>
          <p class="landing-stats-bar__subtext">{{ block.settings.subtext | newline_to_br }}</p>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Project Stats Bar",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "limit": 4,
      "settings": [
        {
          "type": "html",
          "id": "icon",
          "label": "Icon (SVG code)"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Stat Heading"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Subtext",
          "default": "Supporting text goes here"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Project Stats Bar",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "heading": "ONE STOP SERVICE",
            "subtext": "บริการครบวงจรในที่เดียว"
          }
        },
        {
          "type": "stat",
          "settings": {
            "heading": "PROFESSIONAL TEAM",
            "subtext": "ทีมงานมืออาชีพมากประสบการณ์"
          }
        },
        {
          "type": "stat",
          "settings": {
            "heading": "PREMIUM QUALITY",
            "subtext": "คัดสรรอุปกรณ์คุณภาพระดับโลก"
          }
        },
        {
          "type": "stat",
          "settings": {
            "heading": "AFTER SALES SERVICE",
            "subtext": "บริการหลังการขายที่คุณไว้วางใจ"
          }
        }
      ]
    }
  ]
}
{% endschema %}
