    padding: 3px 8px;
    border-radius: 100px;
    letter-spacing: 0.02em;
  }
  .article-toc__chevron {
    transition: transform var(--sf-transition);
    color: var(--sf-primary);
    flex-shrink: 0;
  }
  .article-toc[open] .article-toc__chevron {
    transform: rotate(180deg);
  }
  .article-toc__list {
    list-style: none;
    padding: 0 20px 20px;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    border-top: 1px solid var(--sf-border-light);
    padding-top: 14px;
  }
  .article-toc__item {
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-size: 14px;
    color: var(--sf-text-muted);
    text-decoration: none;
    padding: 6px 10px;
    border-radius: var(--sf-radius-sm);
    transition: all var(--sf-transition);
    line-height: 1.4;
  }
  .article-toc__num {
    font-size: 12px;
    font-weight: 700;
    color: var(--sf-primary);
    font-variant-numeric: tabular-nums;
  }
  .article-toc__text {
    flex: 1;
  }
  .article-toc__item:hover {
    background: var(--sf-surface-tint);
    color: var(--sf-primary-dark);
    transform: translateX(3px);
  }
  .article-toc__item.is-active {
    background: var(--sf-surface-tint);
    color: var(--sf-primary-dark);
    font-weight: 600;
    border-left: 2px solid var(--sf-primary);
  }

  /* ── Rich Text Editorial Prose (RTE) ────────────────────────────── */
  .article-rte {
    font-size: 16.5px;
    line-height: 1.85;
    color: #242B26;
  }
  .article-rte p {
    margin: 0 0 20px;
  }
  .article-rte strong {
    color: var(--sf-text);
    font-weight: 600;
  }

  .article-rte h2 {
    font-size: 24px;
    font-weight: 700;
    color: var(--sf-text);
    margin: 48px 0 20px;
    display: flex;
    align-items: center;
    gap: 12px;
    letter-spacing: -0.015em;
    line-height: 1.3;
    scroll-margin-top: 100px;
  }
  .article-h2__num {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    border-radius: var(--sf-radius-sm);
    background: var(--sf-primary-dark);
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    letter-spacing: -0.02em;
    box-shadow: 0 2px 6px rgba(18, 59, 43, 0.2);
  }
  .article-h2__text {
    flex: 1;
  }

  .article-rte h3 {
    font-size: 19px;
    font-weight: 700;
    color: var(--sf-text);
    margin: 32px 0 14px;
    line-height: 1.35;
  }
  .article-rte h4 {
    font-size: 17px;
    font-weight: 600;
    color: var(--sf-text);
    margin: 24px 0 10px;
  }

  .article-rte a {
    color: var(--sf-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 500;
    transition: color var(--sf-transition);
  }
  .article-rte a:hover {
    color: var(--sf-primary-dark);
  }

  .article-rte ul,
  .article-rte ol {
    margin: 0 0 24px 0;
    padding-left: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .article-rte ul li {
    padding-left: 26px;
    position: relative;
  }
  .article-rte ul li::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 9px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--sf-primary);
  }
  .article-rte ol {
    list-style: decimal;
    margin-left: 24px;
  }

  .article-rte blockquote {
    margin: 32px 0;
    padding: 24px 28px;
    background: var(--sf-surface-soft);
    border-left: 4px solid var(--sf-primary);
    border-radius: 0 var(--sf-radius-md) var(--sf-radius-md) 0;
    font-size: 17px;
    font-style: italic;
    color: var(--sf-primary-dark);
    line-height: 1.65;
    position: relative;
  }
  .article-rte blockquote::before {
    content: '“';
    font-size: 48px;
    line-height: 1;
    color: var(--sf-primary);
    opacity: 0.35;
    position: absolute;
    top: 10px;
    left: 12px;
    font-family: Georgia, serif;
  }

  .article-rte img {
    max-width: 100%;
    height: auto;
    border-radius: var(--sf-radius-md);
    border: 1px solid var(--sf-border);
    margin: 32px 0 16px;
    display: block;
    box-shadow: var(--sf-shadow-sm);
  }
  .article-rte table {
    width: 100%;
    border-collapse: collapse;
    margin: 28px 0;
    font-size: 14px;
    border-radius: var(--sf-radius-md);
    overflow: hidden;
    border: 1px solid var(--sf-border);
  }
  .article-rte th,
  .article-rte td {
    padding: 12px 16px;
    border: 1px solid var(--sf-border);
    text-align: left;
  }
  .article-rte th {
    background: var(--sf-surface-soft);
    color: var(--sf-primary-dark);
    font-weight: 700;
  }
  .article-rte tr:nth-child(even) {
    background-color: #FAFCFA;
  }
  .article-rte hr {
    border: none;
    border-top: 1px solid var(--sf-border);
    margin: 40px 0;
  }

  /* ── Tag Footer ─────────────────────────────────────────────────── */
  .article-tag-footer {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 48px;
    padding-top: 28px;
    border-top: 1px solid var(--sf-border);
  }
  .article-tag-footer__label {
    font-size: 13px;
    font-weight: 600;
    color: var(--sf-text-muted);
  }
  .article-tag-footer__list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .article-tag-footer__link {
    display: inline-block;
    padding: 5px 14px;
    background: var(--sf-surface-soft);
    border: 1px solid var(--sf-border);
    border-radius: 100px;
    font-size: 12.5px;
    font-weight: 500;
    color: var(--sf-text-muted);
    text-decoration: none;
    transition: all var(--sf-transition);
  }
  .article-tag-footer__link:hover {
    border-color: var(--sf-primary);
    color: var(--sf-primary);
    background: var(--sf-surface-tint);
    transform: translateY(-1px);
  }

  /* ── Author Bio Box ─────────────────────────────────────────────── */
  .article-author-card {
    margin-top: 36px;
    padding: 28px;
    background: var(--sf-surface-soft);
    border: 1px solid var(--sf-border);
    border-radius: var(--sf-radius-lg);
    display: flex;
    gap: 20px;
    align-items: flex-start;
  }
  .article-author-card__content {
    flex: 1;
    min-width: 0;
  }
  .article-author-card__head {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 6px;
  }
  .article-author-card__name {
    font-size: 16px;
    font-weight: 700;
    margin: 0;
    color: var(--sf-text);
  }
  .article-author-card__badge {
    font-size: 11px;
    font-weight: 600;
    background: var(--sf-surface-tint);
    color: var(--sf-primary-dark);
    padding: 3px 8px;
    border-radius: 100px;
  }
  .article-author-card__bio {
    font-size: 13.5px;
    color: var(--sf-text-muted);
    line-height: 1.6;
    margin: 0 0 12px;
  }
  .article-author-card__links {
    display: flex;
  }
  .article-author-card__link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 13px;
    font-weight: 600;
    color: var(--sf-primary);
    text-decoration: none;
    transition: gap var(--sf-transition);
  }
  .article-author-card__link:hover {
    gap: 8px;
    text-decoration: underline;
  }

  /* ── Prev / Next Article Navigation ─────────────────────────────── */
  .article-prev-next {
    margin-top: 32px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .article-pn-card {
    border: 1px solid var(--sf-border);
    border-radius: var(--sf-radius-md);
    padding: 18px 20px;
    background: var(--sf-surface);
    text-decoration: none;
    transition: all var(--sf-transition);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .article-pn-card:hover {
    border-color: var(--sf-primary);
    box-shadow: var(--sf-shadow-sm);
    transform: translateY(-2px);
  }
  .article-pn-card__header {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--sf-text-muted);
  }
  .article-pn-card__header svg {
    color: var(--sf-primary);
  }
  .article-pn-card__title {
    font-size: 14px;
    font-weight: 600;
    color: var(--sf-text);
    line-height: 1.4;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .article-pn-card--next {
    text-align: right;
  }
  .article-pn-card--next .article-pn-card__header {
    justify-content: flex-end;
  }

  @media screen and (max-width: 640px) {
    .article-prev-next {
      grid-template-columns: 1fr;
    }
    .article-pn-card--next {
      text-align: left;
    }
    .article-pn-card--next .article-pn-card__header {
      justify-content: flex-start;
    }
  }

  /* ══════════════════════════════════════════════════════════════════
     SIDEBAR CARDS (B2B Conversion System)
     ══════════════════════════════════════════════════════════════════ */
  .article-sidebar {
    display: flex;
    flex-direction: column;
    gap: 24px;
    position: sticky;
    top: 88px;
  }
  .article-side-card {
    background: var(--sf-surface);
    border: 1px solid var(--sf-border);
    border-radius: var(--sf-radius-lg);
    padding: 24px;
    box-shadow: var(--sf-shadow-sm);
    transition: box-shadow var(--sf-transition);
  }
  .article-side-card:hover {
    box-shadow: var(--sf-shadow-md);
  }
  .article-side-card__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--sf-border-light);
  }
  .article-side-card__title {
    font-size: 15px;
    font-weight: 700;
    color: var(--sf-text);
    margin: 0;
    letter-spacing: -0.01em;
  }
  .article-side-card__view-all {
    font-size: 12px;
    font-weight: 600;
    color: var(--sf-primary);
    text-decoration: none;
  }
  .article-side-card__view-all:hover {
    text-decoration: underline;
  }

  /* ── Promo Solution Card ────────────────────────────────────────── */
  .article-promo-card {
    text-align: left;
    overflow: hidden;
  }
  .article-promo-card__image {
    margin: -24px -24px 18px;
    overflow: hidden;
  }
  .article-promo-card__image img {
    width: 100%;
    display: block;
  }
  .article-promo-card__icon-badge {
    width: 44px;
    height: 44px;
    border-radius: var(--sf-radius-md);
    background: var(--sf-surface-soft);
    color: var(--sf-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 14px;
    border: 1px solid var(--sf-border);
  }
  .article-promo-card__list {
    list-style: none;
    padding: 0;
    margin: 16px 0 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .article-promo-card__list li {
    font-size: 13px;
    color: var(--sf-text);
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .article-promo-card__list li svg {
    color: var(--sf-primary);
    flex-shrink: 0;
  }
  .article-promo-card__btn {
    width: 100%;
    justify-content: center;
  }

  /* ── Request a Quote Card (Dark Green Luxury) ────────────────────── */
  .article-quote-card {
    background: linear-gradient(145deg, #123B2B 0%, #1A4F3A 100%);
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 0.12);
  }
  .article-quote-card__badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    background: rgba(52, 211, 153, 0.15);
    color: #34D399;
    border: 1px solid rgba(52, 211, 153, 0.3);
    padding: 4px 10px;
    border-radius: 100px;
    margin-bottom: 12px;
  }
  .article-quote-card__title {
    font-size: 18px;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 6px;
  }
  .article-quote-card__sub {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.75);
    margin: 0 0 16px;
    line-height: 1.45;
  }
  .article-quote-card__perks {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 18px;
    padding-bottom: 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  .article-quote-perk {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12.5px;
    color: rgba(255, 255, 255, 0.9);
  }
  .article-quote-perk svg {
    color: #34D399;
    flex-shrink: 0;
  }
  
  .article-quote-card__form {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .article-quote-card__form input.article-quote-card__input,
  .article-quote-card__form input[type="text"],
  .article-quote-card__form input[type="tel"],
  .article-quote-card__form input[type="email"] {
    width: 100% !important;
    box-sizing: border-box !important;
    padding: 12px 16px !important;
    border-radius: 8px !important;
    border: 1.5px solid #34D399 !important;
    background: rgba(18, 59, 43, 0.65) !important;
    color: #FFFFFF !important;
    font-size: 13.5px !important;
    font-family: inherit !important;
    line-height: 1.4 !important;
    outline: none !important;
    box-shadow: none !important;
    transition: all var(--sf-transition) !important;
    -webkit-appearance: none !important;
  }
  .article-quote-card__form input.article-quote-card__input::placeholder,
  .article-quote-card__form input[type="text"]::placeholder,
  .article-quote-card__form input[type="tel"]::placeholder,
  .article-quote-card__form input[type="email"]::placeholder {
    color: rgba(255, 255, 255, 0.65) !important;
    font-size: 13px !important;
  }
  .article-quote-card__form input.article-quote-card__input:hover,
  .article-quote-card__form input[type="text"]:hover,
  .article-quote-card__form input[type="tel"]:hover,
  .article-quote-card__form input[type="email"]:hover {
    border-color: #6EE7B7 !important;
    background: rgba(18, 59, 43, 0.8) !important;
  }
  .article-quote-card__form input.article-quote-card__input:focus,
  .article-quote-card__form input[type="text"]:focus,
  .article-quote-card__form input[type="tel"]:focus,
  .article-quote-card__form input[type="email"]:focus {
    border-color: #34D399 !important;
    background: rgba(18, 59, 43, 0.9) !important;
    box-shadow: 0 0 0 3px rgba(52, 211, 153, 0.25) !important;
  }
  .article-quote-card__submit {
    width: 100%;
    justify-content: center;
    background: #1F6B4D;
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 0.2);
    margin-top: 4px;
  }
  .article-quote-card__submit:hover {
    background: #288E67;
  }
  .article-quote-card__success {
    background: rgba(52, 211, 153, 0.1);
    border: 1px solid rgba(52, 211, 153, 0.3);
    padding: 16px;
    border-radius: var(--sf-radius-sm);
    font-size: 13px;
    color: #FFFFFF;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }
  .article-quote-card__error {
    font-size: 12.5px;
    color: #FF8A80;
    margin: 0 0 10px;
  }

  .article-quote-card__direct {
    margin-top: 18px;
    padding-top: 14px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 12px;
    color: rgba(255, 255, 255, 0.7);
  }
  .article-quote-card__direct-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-top: 8px;
  }
  .article-direct-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 7px 10px;
    border-radius: var(--sf-radius-sm);
    background: rgba(255, 255, 255, 0.1);
    color: #FFFFFF;
    font-size: 11.5px;
    font-weight: 600;
    text-decoration: none;
    transition: background var(--sf-transition);
  }
  .article-direct-btn:hover {
    background: rgba(255, 255, 255, 0.2);
  }
  .article-direct-btn--line {
    background: #06C755;
    color: #FFFFFF;
  }
  .article-direct-btn--line:hover {
    background: #05B34C;
  }

  /* ── Download Brochure Card ─────────────────────────────────────── */
  .article-brochure-card {
    background: var(--sf-surface-soft);
    border: 1px solid var(--sf-border);
    text-align: center;
  }
  .article-brochure-card__badge {
    display: inline-block;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--sf-primary);
    background: var(--sf-surface-tint);
    padding: 3px 8px;
    border-radius: 4px;
    margin-bottom: 8px;
  }
  .article-brochure-card__sub {
    font-size: 12.5px;
    color: var(--sf-text-muted);
    margin: 6px 0 16px;
    line-height: 1.45;
  }
  .article-brochure-card__preview {
    padding: 20px;
    background: var(--sf-surface);
    border: 1px dashed var(--sf-border);
    border-radius: var(--sf-radius-md);
    margin-bottom: 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    color: var(--sf-primary);
  }
  .article-brochure-card__file-meta {
    font-size: 12px;
    font-weight: 600;
    color: var(--sf-text-muted);
  }
  .article-brochure-card__btn {
    width: 100%;
    justify-content: center;
  }

  /* ── Related Articles & Equipment Lists ─────────────────────────── */
  .article-products-card {
    background: var(--sf-surface);
    border: 1px solid var(--sf-border);
    position: relative;
    overflow: hidden;
  }
  .article-products-card__top {
    margin-bottom: 12px;
  }
  .article-products-card__badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sf-primary);
    background: var(--sf-surface-tint);
    padding: 3px 8px;
    border-radius: 4px;
    margin-bottom: 8px;
  }
  .article-products-card__sub {
    font-size: 12.5px;
    color: var(--sf-text-muted);
    margin: -8px 0 12px;
    line-height: 1.4;
  }
  .article-products-card__btn {
    width: 100%;
    margin-top: 14px;
    justify-content: center;
    font-size: 12.5px;
    padding: 9px 16px;
  }
  .article-related-list {
    display: flex;
    flex-direction: column;
  }
  .article-related-item {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    text-decoration: none;
    padding: 12px 0;
    border-bottom: 1px solid var(--sf-border-light);
    transition: transform var(--sf-transition);
  }
  .article-related-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  .article-related-item:first-child {
    padding-top: 0;
  }
  .article-related-item:hover {
    transform: translateX(2px);
  }
  .article-related-item__thumb {
    flex-shrink: 0;
    width: 64px;
    height: 64px;
    border-radius: var(--sf-radius-sm);
    overflow: hidden;
    background: var(--sf-surface-soft);
    border: 1px solid var(--sf-border-light);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--sf-text-subtle);
  }
  .article-related-item__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .article-related-item__info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .article-related-item__vendor {
    font-size: 10.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--sf-primary);
    opacity: 0.9;
  }
  .article-related-item__date {
    font-size: 11.5px;
    color: var(--sf-text-subtle);
  }
  .article-related-item__title {
    font-size: 13px;
    font-weight: 600;
    color: var(--sf-text);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color var(--sf-transition);
  }
  .article-related-item:hover .article-related-item__title {
    color: var(--sf-primary);
  }
  .article-related-item__price-row {
    display: flex;
    align-items: baseline;
    gap: 6px;
    flex-wrap: wrap;
    margin-top: 1px;
  }
  .article-related-item__price {
    font-size: 13px;
    font-weight: 700;
    color: var(--sf-primary-dark);
  }
  .article-related-item__compare-price {
    font-size: 11.5px;
    color: var(--sf-text-subtle);
    text-decoration: line-through;
  }
  .article-related-item__price-request {
    font-size: 12px;
    font-weight: 600;
    color: var(--sf-primary);
  }
  .article-related-item__sub {
    font-size: 12px;
    color: var(--sf-primary);
    font-weight: 600;
  }
  .article-related-item__link,
  .article-related-item__action {
    color: var(--sf-primary);
    font-size: 12px;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 4px;
    margin-top: 2px;
  }

  /* ── FAQ / Q&A Accordion Section ────────────────────────────────── */
  .article-faq-section {
    margin: 44px 0;
    padding: 32px 28px;
    background: linear-gradient(180deg, #F7FAF8 0%, #FFFFFF 100%);
    border: 1.5px solid rgba(31, 107, 77, 0.18);
    border-radius: var(--sf-radius-lg);
    box-shadow: 0 4px 20px rgba(18, 59, 43, 0.04);
  }
  .article-faq-header {
    margin-bottom: 22px;
  }
  .article-faq-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    background: rgba(31, 107, 77, 0.1);
    color: var(--sf-primary);
    padding: 4px 10px;
    border-radius: 100px;
    margin-bottom: 8px;
  }
  .article-faq-title {
    font-size: 22px;
    font-weight: 700;
    color: var(--sf-primary-dark);
    margin: 0 0 6px;
    display: flex;
    align-items: center;
    gap: 10px;
    letter-spacing: -0.01em;
  }
  .article-faq-title__icon {
    display: inline-flex;
    color: var(--sf-primary);
    flex-shrink: 0;
  }
  .article-faq-subtitle {
    font-size: 13.5px;
    color: var(--sf-text-muted);
    margin: 0;
    line-height: 1.5;
  }
  .article-faq-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .article-faq-item {
    background: #FFFFFF;
    border: 1px solid var(--sf-border);
    border-radius: var(--sf-radius-md);
    overflow: hidden;
    transition: all var(--sf-transition);
  }
  .article-faq-item:hover {
    border-color: var(--sf-primary);
    box-shadow: 0 3px 12px rgba(31, 107, 77, 0.06);
  }
  .article-faq-item[open] {
    border-color: var(--sf-primary);
    box-shadow: 0 4px 16px rgba(31, 107, 77, 0.08);
  }
  .article-faq-item__question {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 18px;
    cursor: pointer;
    user-select: none;
    font-size: 14.5px;
    font-weight: 600;
    color: var(--sf-text);
    transition: background var(--sf-transition);
  }
  .article-faq-item__question::-webkit-details-marker {
    display: none;
  }
  .article-faq-item__question:hover {
    background: #FAFCFA;
  }
  .article-faq-item__q-badge {
    flex-shrink: 0;
    width: 26px;
    height: 26px;
    border-radius: 7px;
    background: var(--sf-primary);
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 6px rgba(31, 107, 77, 0.25);
  }
  .article-faq-item__q-text {
    flex: 1;
    line-height: 1.45;
  }
  .article-faq-item__icon {
    flex-shrink: 0;
    color: var(--sf-primary);
    transition: transform var(--sf-transition);
  }
  .article-faq-item[open] .article-faq-item__icon {
    transform: rotate(180deg);
  }
  .article-faq-item__answer {
    padding: 0 18px 18px;
    background: #FAFCFA;
    border-top: 1px dashed var(--sf-border-light);
  }
  .article-faq-item__a-wrapper {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding-top: 14px;
  }
  .article-faq-item__a-badge {
    flex-shrink: 0;
    width: 26px;
    height: 26px;
    border-radius: 7px;
    background: rgba(31, 107, 77, 0.12);
    color: var(--sf-primary-dark);
    font-size: 13px;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .article-faq-item__a-text {
    flex: 1;
    font-size: 14px;
    color: #374151;
    line-height: 1.7;
  }

  /* ── Product Callout Box ─────────────────────────────────────────── */
  .article-product-callout {
    margin-top: 36px;
    padding: 26px 28px;
    background: linear-gradient(135deg, #F3F8F5 0%, #EDF5F1 100%);
    border: 1.5px solid rgba(31, 107, 77, 0.22);
    border-radius: var(--sf-radius-lg);
    display: flex;
    gap: 20px;
    align-items: flex-start;
    box-shadow: 0 2px 10px rgba(18, 59, 43, 0.04);
  }
  .article-product-callout__icon {
    flex-shrink: 0;
    width: 46px;
    height: 46px;
    border-radius: 10px;
    background: #123B2B;
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 3px 8px rgba(18, 59, 43, 0.25);
  }
  .article-product-callout__content {
    flex: 1;
    min-width: 0;
  }
  .article-product-callout__text {
    font-size: 14.5px;
    color: #1C1F1D;
    line-height: 1.68;
    margin: 0 0 16px;
    font-weight: 450;
  }
  .article-product-callout__btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13.5px;
    font-weight: 600;
    padding: 11px 22px;
    border-radius: var(--sf-radius-sm);
    background: var(--sf-primary);
    color: #FFFFFF !important;
    text-decoration: none !important;
    box-shadow: 0 2px 6px rgba(31, 107, 77, 0.25);
    transition: all var(--sf-transition);
  }
  .article-product-callout__btn:hover {
    background: var(--sf-primary-hover);
    color: #FFFFFF !important;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(31, 107, 77, 0.35);
  }

  @media screen and (max-width: 640px) {
    .article-faq-section {
      padding: 24px 18px;
    }
    .article-product-callout {
      flex-direction: column;
      padding: 20px;
      gap: 14px;
    }
  }

  /* ── Dedicated B2B Featured Product Card ─────────────────────────── */
  .article-product-card {
    margin: 40px 0;
    padding: 24px;
    background: #FFFFFF;
    border: 1.5px solid rgba(31, 107, 77, 0.2);
    border-radius: var(--sf-radius-lg);
    box-shadow: 0 6px 24px rgba(18, 59, 43, 0.07);
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 24px;
    align-items: center;
    position: relative;
    overflow: hidden;
    transition: transform var(--sf-transition), box-shadow var(--sf-transition), border-color var(--sf-transition);
  }
  .article-product-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, #123B2B, #1F6B4D, #34D399);
  }
  .article-product-card:hover {
    border-color: var(--sf-primary);
    box-shadow: 0 10px 32px rgba(18, 59, 43, 0.12);
    transform: translateY(-2px);
  }
  .article-product-card__media {
    position: relative;
    background: #F4F8F6;
    border: 1px solid var(--sf-border-light);
    border-radius: var(--sf-radius-md);
    padding: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }
  .article-product-card__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.3s ease;
    z-index: 1;
  }
  .article-product-card:hover .article-product-card__img {
    transform: scale(1.04);
  }
  .article-product-card__badge {
    position: absolute;
    top: 10px;
    left: 10px;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: #123B2B;
    color: #FFFFFF;
    padding: 4px 8px;
    border-radius: 4px;
    box-shadow: 0 2px 6px rgba(0,0,0,0.18);
    z-index: 3;
    line-height: 1.2;
  }
  .article-product-card__info {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .article-product-card__meta-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    min-height: 42px;
    margin-bottom: 4px;
  }
  .article-product-card__brand-link {
    display: inline-flex;
    align-items: center;
    text-decoration: none !important;
    padding: 0;
    transition: all var(--sf-transition);
  }
  .article-product-card__brand-link:hover {
    transform: translateY(-1px) scale(1.03);
    opacity: 0.88;
  }
  .article-product-card__brand-logo {
    max-height: 40px;
    max-width: 165px;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
  }
  .article-product-card__vendor {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #1F6B4D !important;
    background: #EAF3EF;
    border: 1px solid rgba(31, 107, 77, 0.2);
    padding: 6px 12px;
    border-radius: 6px;
    text-decoration: none !important;
    cursor: pointer;
    transition: all var(--sf-transition);
  }
  .article-product-card__vendor:hover {
    background: #1F6B4D;
    color: #FFFFFF !important;
    border-color: #1F6B4D;
    transform: translateY(-1px);
    box-shadow: 0 2px 8px rgba(31, 107, 77, 0.25);
  }
  .article-product-card__vendor svg {
    transition: transform var(--sf-transition);
  }
  .article-product-card__vendor:hover svg {
    transform: translate(1px, -1px);
  }
  .article-product-card__status {
    font-size: 11.5px;
    font-weight: 700;
    color: #1F6B4D;
    background: #EAF3EF;
    border: 1px solid rgba(31, 107, 77, 0.18);
    padding: 4px 10px;
    border-radius: 20px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    letter-spacing: 0.02em;
  }
  .article-product-card__title {
    font-size: 20px;
    font-weight: 700;
    color: #123B2B;
    margin: 2px 0 0;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }
  .article-product-card__title a {
    color: inherit;
    text-decoration: none;
    transition: color var(--sf-transition);
  }
  .article-product-card__title a:hover {
    color: var(--sf-primary);
  }
  .article-product-card__desc {
    font-size: 13.5px;
    color: var(--sf-text-muted);
    line-height: 1.55;
    margin: 0;
  }
  .article-product-card__specs {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px;
    margin-top: 2px;
  }
  .article-product-spec {
    display: flex;
    align-items: center;
    gap: 8px;
    background: #F5F9F7;
    border: 1px solid #E2EDE7;
    padding: 6px 10px;
    border-radius: 6px;
    font-size: 12px;
    color: #2D3748;
  }
  .article-product-spec svg {
    color: var(--sf-primary);
    flex-shrink: 0;
  }
  .article-product-spec strong {
    font-weight: 600;
  }
  .article-product-card__actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 6px;
    padding-top: 12px;
    border-top: 1px solid var(--sf-border-light);
  }
  .article-product-card__btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: #1F6B4D;
    color: #FFFFFF !important;
    font-size: 13.5px;
    font-weight: 600;
    padding: 10px 20px;
    border-radius: var(--sf-radius-sm);
    text-decoration: none !important;
    transition: all var(--sf-transition);
    box-shadow: 0 2px 6px rgba(31, 107, 77, 0.25);
  }
  .article-product-card__btn-primary:hover {
    background: #17553D;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(31, 107, 77, 0.35);
  }
  .article-product-card__btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    background: transparent;
    color: var(--sf-primary) !important;
    border: 1.5px solid var(--sf-border);
    font-size: 13px;
    font-weight: 600;
    padding: 9px 16px;
    border-radius: var(--sf-radius-sm);
    text-decoration: none !important;
    transition: all var(--sf-transition);
  }
  .article-product-card__btn-secondary:hover {
    background: var(--sf-surface-soft);
    border-color: var(--sf-primary);
    color: var(--sf-primary-dark) !important;
  }

  @media screen and (max-width: 768px) {
    .article-product-card {
      grid-template-columns: 1fr;
      padding: 20px;
      gap: 16px;
    }
    .article-product-card__media {
      max-height: 220px;
    }
    .article-product-card__specs {
      grid-template-columns: 1fr;
    }
  }

  /* ══════════════════════════════════════════════════════════════════
     BUTTON SYSTEM
     ══════════════════════════════════════════════════════════════════ */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    padding: 12px 22px;
    border-radius: var(--sf-radius-md);
    white-space: nowrap;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: all var(--sf-transition);
    line-height: 1;
  }
  .btn:hover {
    transform: translateY(-1px);
  }
  .btn--lg {
    padding: 14px 28px;
    font-size: 15px;
  }
  .btn--primary {
    background: var(--sf-primary);
    color: #FFFFFF;
    box-shadow: 0 2px 6px rgba(31, 107, 77, 0.25);
  }
  .btn--primary:hover {
    background: var(--sf-primary-hover);
    box-shadow: 0 4px 12px rgba(31, 107, 77, 0.35);
  }
  .btn--outline-primary {
    background: transparent;
    border: 1.5px solid var(--sf-primary);
    color: var(--sf-primary);
  }
  .btn--outline-primary:hover {
    background: var(--sf-surface-soft);
    border-color: var(--sf-primary-dark);
    color: var(--sf-primary-dark);
  }
  .btn--outline-light {
    background: transparent;
    border: 1.5px solid rgba(255, 255, 255, 0.4);
    color: #FFFFFF;
  }
  .btn--outline-light:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: #FFFFFF;
  }

  /* ── Bottom B2B Consultation CTA Banner ──────────────────────────── */
  .article-bottom-cta {
    background: linear-gradient(135deg, #123B2B 0%, #1F6B4D 60%, #17553D 100%);
    color: #FFFFFF;
    border-radius: var(--sf-radius-xl);
    padding: 48px 40px;
    margin-top: 16px;
    box-shadow: var(--sf-shadow-lg);
    position: relative;
    overflow: hidden;
  }
  .article-bottom-cta::after {
    content: '';
    position: absolute;
    right: -60px;
    bottom: -60px;
    width: 240px;
    height: 240px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(52, 211, 153, 0.15) 0%, transparent 70%);
    pointer-events: none;
  }
  .article-bottom-cta__content {
    position: relative;
    z-index: 1;
    max-width: 720px;
  }
  .article-bottom-cta__badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    background: rgba(255, 255, 255, 0.15);
    color: #FFFFFF;
    padding: 5px 12px;
    border-radius: 100px;
    margin-bottom: 14px;
    backdrop-filter: blur(4px);
  }
  .article-bottom-cta__title {
    font-size: clamp(24px, 3.2vw, 36px);
    font-weight: 700;
    margin: 0 0 12px;
    line-height: 1.25;
    color: #FFFFFF;
  }
  .article-bottom-cta__sub {
    color: rgba(255, 255, 255, 0.85);
    font-size: 15px;
    line-height: 1.6;
    margin: 0 0 28px;
  }
  .article-bottom-cta__actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  /* ── Copy Toast Notification ─────────────────────────────────────── */
  .article-toast {
    position: fixed;
    bottom: 24px;
    right: 24px;
    background: #123B2B;
    color: #FFFFFF;
    padding: 12px 20px;
    border-radius: 100px;
    font-size: 13.5px;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 8px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
    z-index: 999;
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
  }
  .article-toast.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Article Body",
  "tag": "section",
  "class": "section-wrapper article-body-section",
  "settings": [
    {
      "type": "header",
      "content": "Content Options"
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show excerpt / lead paragraph",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_toc",
      "label": "Show table of contents",
      "default": true,
      "info": "Auto-generates from H2 headings in the article."
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "Show tags in header",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_read_time",
      "label": "Show reading time",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_share_sidebar",
      "label": "Show share buttons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sidebar_tags",
      "label": "Show topic tags at end of article",
      "default": true
    },
    {
      "type": "header",
      "content": "Promo / Solutions Card"
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "Show solutions card",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_title",
      "label": "Card Title",
      "default": "Complete Solutions for Commercial Kitchens"
    },
    {
      "type": "text",
      "id": "cta_bullet_1",
      "label": "Bullet 1",
      "default": "Custom 3D Kitchen Design & Layout"
    },
    {
      "type": "text",
      "id": "cta_bullet_2",
      "label": "Bullet 2",
      "default": "Direct Import Commercial Equipment"
    },
    {
      "type": "text",
      "id": "cta_bullet_3",
      "label": "Bullet 3",
      "default": "Turnkey Installation & 24/7 Service"
    },
    {
      "type": "text",
      "id": "cta_button_text",
      "label": "Button text",
      "default": "View Our Services"
    },
    {
      "type": "url",
      "id": "cta_button_link",
      "label": "Button link"
    },
    {
      "type": "image_picker",
      "id": "cta_image",
      "label": "Card Image"
    },
    {
      "type": "checkbox",
      "id": "show_related",
      "label": "Show related articles in sidebar",
      "default": true
    },
    {
      "type": "header",
      "content": "FAQ / Q&A Settings"
    },
    {
      "type": "checkbox",
      "id": "show_faq",
      "label": "Enable FAQ Section",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "auto_parse_faq",
      "label": "Auto-parse Q&A in Article Content",
      "info": "Automatically converts Q: and A: in blog content to interactive accordions and Google FAQ schema",
      "default": true
    },
    {
      "type": "text",
      "id": "faq_badge",
      "label": "FAQ Badge Text",
      "default": "Q&A / FAQ"
    },
    {
      "type": "text",
      "id": "faq_title",
      "label": "FAQ Section Title",
      "default": "Frequently Asked Questions (FAQ)"
    },
    {
      "type": "textarea",
      "id": "faq_subtitle",
      "label": "FAQ Subtitle",
      "default": "Common questions regarding commercial equipment selection, operation, and maintenance."
    },
    {
      "type": "header",
      "content": "Style & Spacing"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top Padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom Padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "header",
      "content": "Bottom CTA Banner"
    },
    {
