          var isThai = /[\u0E00-\u0E7F]/.test(cleanText);
          var handleMatch = targetUrl.match(/\/products\/([a-zA-Z0-9\-_]+)/);
          var productHandle = handleMatch ? handleMatch[1] : 'hood-dishwasher-500x500mm-rack';

          var badgeText = isThai ? 'MADE IN ITALY' : 'MADE IN ITALY';
