</div>

<script>
  (function() {
    var tocEnabled = {{ section.settings.show_toc | json }};
    if (!tocEnabled) return;

    function buildTOC() {
      var rte = document.getElementById('article-rte');
      if (!rte) return;
      var headings = rte.querySelectorAll('h2');
      if (headings.length < 2) return;

      var listInline = document.getElementById('article-toc-list-inline');
      var listSidebar = document.getElementById('article-toc-list-sidebar');
      var tocInline = document.getElementById('article-toc-inline');
      var tocSidebar = document.getElementById('article-toc-sidebar');
      var items = '';

      headings.forEach(function(h, i) {
        if (!h.id) h.id = 'heading-' + i;
        var num = (i + 1).toString().padStart(2, '0');
        var originalText = h.textContent;
        if (!h.querySelector('.article-h2__num')) {
          h.innerHTML = '<span class="article-h2__num">' + num + '</span> ' + h.innerHTML;
        } else {
          originalText = h.textContent.replace(num, '').trim();
        }
        items += '<li><a href="#' + h.id + '"><span class="article-toc__num">' + num + '</span> ' + originalText + '</a></li>';
      });

      if (listInline) listInline.innerHTML = items;
      if (listSidebar) listSidebar.innerHTML = items;
      if (tocInline) tocInline.style.display = '';
      if (tocSidebar) tocSidebar.style.display = '';

      // Active link on scroll
      var tocLinks = document.querySelectorAll('.article-toc__list a');
      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            tocLinks.forEach(function(link) {
              link.classList.toggle('is-active', link.getAttribute('href') === '#' + entry.target.id);
            });
          }
        });
      }, { rootMargin: '-20% 0px -60% 0px' });

      headings.forEach(function(h) { observer.observe(h); });
    }

    // Copy link
    var copyBtn = document.getElementById('copy-link-btn');
    if (copyBtn) {
      copyBtn.addEventListener('click', function() {
        navigator.clipboard.writeText(copyBtn.dataset.url).then(function() {
          copyBtn.textContent = 'Copied!';
          setTimeout(function() {
            copyBtn.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg> Copy link';
          }, 2000);
        });
      });
    }

    // Sidebar Copy link
    var sidebarCopyBtn = document.getElementById('sidebar-copy-link-btn');
    if (sidebarCopyBtn) {
      sidebarCopyBtn.addEventListener('click', function() {
        navigator.clipboard.writeText(sidebarCopyBtn.dataset.url).then(function() {
          sidebarCopyBtn.classList.add('is-copied');
          setTimeout(function() {
            sidebarCopyBtn.classList.remove('is-copied');
          }, 2000);
        });
      });
    }

    document.addEventListener('DOMContentLoaded', buildTOC);
    if (document.readyState !== 'loading') buildTOC();
  })();
</script>

