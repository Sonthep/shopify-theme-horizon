  }

  /* ── Featured Image (Inside Main Column) ────────────────────────── */
  .article-featured-media {
    position: relative;
    margin: 0 0 24px 0;
    border-radius: var(--sf-radius-lg);
    overflow: hidden;
    border: 1px solid var(--sf-border);
    box-shadow: var(--sf-shadow-sm);
    aspect-ratio: 16 / 9;
    max-height: 440px;
    background: var(--sf-surface-soft);
    width: 100%;
  }
  .article-featured-media__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }
  .article-featured-media:hover .article-featured-media__img {
    transform: scale(1.02);
  }

  /* ── 2-Column Main Layout ────────────────────────────────────────── */
  .article-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: 36px;
    padding-block: 20px 32px;
    align-items: start;
    position: relative;
    width: 100%;
  }
  .article-main {
    min-width: 0;
    width: 100%;
