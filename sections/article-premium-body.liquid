    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: #D1B074;
    color: #123B2B;
    padding: 10px 16px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s;
    width: 100%;
  }

  .article-sidebar-cta__btn:hover { background: #e2c084; }

  .article-sidebar-cta__image-wrap {
    position: relative;
    width: 100%;
    height: 140px;
    margin-top: auto;
  }

  .article-sidebar-cta__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .article-sidebar-cta__image-wrap--placeholder svg {
    width: 100%;
    height: 100%;
    fill: #ffffff;
    opacity: 0.2;
  }

  /* Related posts */
  .article-related__list {
    display: flex;
    flex-direction: column;
  }

  .article-related__item {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    text-decoration: none;
    padding: 12px 0;
    border-bottom: 1px solid #F3F8F5;
  }

  .article-related__item:last-child {
    border-bottom: none;
  }

  .article-related__thumb {
    flex-shrink: 0;
    width: 64px;
    height: 64px;
    border-radius: 8px;
    overflow: hidden;
    background: #F3F8F5;
  }

  .article-related__thumb--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #D9E3DD;
  }

  .article-related__thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .article-related__info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .article-related__title {
    font-size: 13px;
    font-weight: 500;
    color: #1C1F1D;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.2s;
  }

  .article-related__item:hover .article-related__title {
    color: #1F6B4D;
  }

  .article-related__date {
    font-size: 12px;
    color: #5E6A63;
  }
{% endstylesheet %}

