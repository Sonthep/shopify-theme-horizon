                '</a>' +
                '<a href="tel:024237575" class="article-product-card__btn-secondary">' +
                  '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>' +
                  '<span>' + callText + '</span>' +
                '</a>' +
              '</div>' +
            '</div>';

          targetP.parentNode.replaceChild(card, targetP);

          // Fetch real product details dynamically via Shopify Product JSON API from handle
          if (productHandle) {
            fetch('/products/' + productHandle + '.js')
              .then(function(res) { return res.ok ? res.json() : null; })
              .then(function(prod) {
                if (!prod) return;
                var imgEl = card.querySelector('.js-product-card-img');
                var phEl = card.querySelector('.js-product-card-placeholder');
                var titleEl = card.querySelector('.js-product-card-title');
                var btnEl = card.querySelector('.article-product-card__btn-primary');

                if (prod.featured_image && imgEl) {
                  imgEl.src = prod.featured_image;
                  imgEl.style.display = 'block';
                  if (phEl) phEl.style.display = 'none';
                }
                if (prod.title && titleEl && (!titleEl.textContent || titleEl.textContent.includes('Colged SteelTech 38-00'))) {
                  titleEl.textContent = prod.title;
                  if (prod.url) titleEl.href = prod.url;
                }
                if (prod.url && btnEl) {
                  btnEl.href = prod.url;
                }
              })
              .catch(function() {});
          }
          break;
        }
      }
    }

    function buildTOC() {
      if (!tocEnabled) return;
      var rte = document.getElementById('article-rte');
      var list = document.getElementById('article-toc-list');
      var toc = document.getElementById('article-toc');
      var countEl = document.getElementById('article-toc-count');
      if (!rte || !list || !toc) return;

      var headings = Array.from(document.querySelectorAll('#article-rte h2, .article-faq-title'));
      if (headings.length < 2) {
        var wrapper = toc.closest('.article-toc-wrapper');
        if (wrapper) wrapper.style.display = 'none';
        return;
      }

      if (countEl) {
        countEl.textContent = headings.length + ' Sections';
      }

      var items = '';
      headings.forEach(function(h, i) {
        if (!h.id) h.id = 'section-' + (i + 1);
        var num = (i + 1).toString().padStart(2, '0');
        
        // Enhance H2 with numbered pill badge if not already added (except FAQ header)
        if (!h.classList.contains('article-faq-title') && !h.querySelector('.article-h2__num')) {
          var cleanText = h.textContent.replace(/^\d+\s*/, '').trim();
          h.innerHTML = '<span class="article-h2__num">' + num + '</span> <span class="article-h2__text">' + cleanText + '</span>';
        }
        
        var linkText = h.querySelector('.article-h2__text') ? h.querySelector('.article-h2__text').textContent : h.textContent.replace(/^\d+\s*/, '').trim();
        items += '<li><a href="#' + h.id + '" class="article-toc__item"><span class="article-toc__num">' + num + '</span><span class="article-toc__text">' + linkText + '</span></a></li>';
      });
      list.innerHTML = items;

      // ScrollSpy Observer
      var tocLinks = list.querySelectorAll('.article-toc__item');
      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            tocLinks.forEach(function(link) {
              var isCurrent = link.getAttribute('href') === '#' + entry.target.id;
              link.classList.toggle('is-active', isCurrent);
            });
          }
        });
      }, { rootMargin: '-10% 0px -70% 0px' });

      headings.forEach(function(h) { observer.observe(h); });

      // Smooth scroll for TOC links
      tocLinks.forEach(function(link) {
        link.addEventListener('click', function(e) {
          e.preventDefault();
          var targetId = this.getAttribute('href').substring(1);
          var targetEl = document.getElementById(targetId);
          if (targetEl) {
            var yOffset = -90;
            var y = targetEl.getBoundingClientRect().top + window.pageYOffset + yOffset;
            window.scrollTo({ top: y, behavior: 'smooth' });
          }
        });
      });
    }

    function showToast(message) {
      var toast = document.getElementById('article-toast');
      if (!toast) return;
      if (message) {
        var span = toast.querySelector('span');
        if (span) span.textContent = message;
      }
      toast.classList.add('is-visible');
      setTimeout(function() {
        toast.classList.remove('is-visible');
      }, 2500);
    }

    function bindCopyButtons() {
      document.querySelectorAll('.js-copy-link').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          var url = btn.dataset.url || window.location.href;
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(url).then(function() {
              btn.classList.add('is-copied');
              showToast('Article link copied to clipboard!');
              setTimeout(function() { btn.classList.remove('is-copied'); }, 2000);
            }).catch(function() {
              fallbackCopy(url);
            });
          } else {
            fallbackCopy(url);
          }
        });
      });
    }

    function fallbackCopy(text) {
      var textarea = document.createElement('textarea');
      textarea.value = text;
      textarea.style.position = 'fixed';
      textarea.style.opacity = '0';
      document.body.appendChild(textarea);
      textarea.select();
      try {
        document.execCommand('copy');
        showToast('Article link copied to clipboard!');
      } catch (err) {
        prompt('Copy this link:', text);
      }
      document.body.removeChild(textarea);
    }

    function init() {
      parseArticleFAQ();
      buildTOC();
      bindCopyButtons();
    }

    if (document.readyState !== 'loading') {
      init();
    } else {
      document.addEventListener('DOMContentLoaded', init);
    }
  })();
</script>

{% stylesheet %}
  /* ══════════════════════════════════════════════════════════════════
     SEVENFIVE B2B PREMIUM ARTICLE DESIGN SYSTEM
     ══════════════════════════════════════════════════════════════════ */
  .article-body {
    --sf-primary: #1F6B4D;
    --sf-primary-hover: #17553D;
    --sf-primary-dark: #123B2B;
    --sf-surface: #FFFFFF;
    --sf-surface-soft: #F3F8F5;
    --sf-surface-tint: #EAF2EE;
    --sf-border: #D9E3DD;
    --sf-border-light: #EBEFE8;
    --sf-text: #1C1F1D;
    --sf-text-muted: #5E6A63;
    --sf-text-subtle: #87948C;
    --sf-radius-sm: 8px;
    --sf-radius-md: 12px;
    --sf-radius-lg: 16px;
    --sf-radius-xl: 20px;
    --sf-shadow-sm: 0 1px 3px rgba(18, 59, 43, 0.05);
    --sf-shadow-md: 0 8px 24px rgba(18, 59, 43, 0.07);
    --sf-shadow-lg: 0 16px 36px rgba(18, 59, 43, 0.10);
    --sf-transition: 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    
    color: var(--sf-text);
    background-color: var(--sf-surface);
    font-family: inherit;
    line-height: 1.6;
  }

  /* ── Article Container ──────────────────────────────────────────── */
  .article-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    box-sizing: border-box;
    width: 100%;
  }

  /* ── Breadcrumb ─────────────────────────────────────────────────── */
  .article-main__breadcrumb {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 13px;
    color: var(--sf-text-muted);
    padding-top: 28px;
    margin-bottom: 20px;
  }
  .article-breadcrumb__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--sf-text-muted);
    text-decoration: none;
    transition: color var(--sf-transition);
  }
  .article-breadcrumb__link:hover {
    color: var(--sf-primary);
  }
  .article-breadcrumb__sep {
    color: var(--sf-text-subtle);
    display: inline-flex;
    align-items: center;
  }
  .article-breadcrumb__current {
    color: var(--sf-text);
    font-weight: 500;
  }

  /* ── Article Header ─────────────────────────────────────────────── */
  .article-header {
    max-width: 100%;
    margin-bottom: 24px;
  }

  .article-main__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 16px;
  }
  .article-tag-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--sf-primary-dark);
    background: var(--sf-surface-soft);
    border: 1px solid var(--sf-border);
    padding: 6px 14px;
    border-radius: 100px;
    text-decoration: none;
    transition: all var(--sf-transition);
  }
  .article-tag-pill:hover {
    background: var(--sf-surface-tint);
    border-color: var(--sf-primary);
    color: var(--sf-primary);
    transform: translateY(-1px);
  }
  .article-tag-pill__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--sf-primary);
  }

  .article-main__title {
    font-size: clamp(26px, 3.2vw, 40px);
    font-weight: 700;
    line-height: 1.22;
    color: var(--sf-text);
    margin: 0 0 20px;
    letter-spacing: -0.02em;
    text-wrap: pretty;
  }

  .article-main__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--sf-border);
  }
  .article-main__meta-left {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 18px;
  }
  .article-main__meta-item {
