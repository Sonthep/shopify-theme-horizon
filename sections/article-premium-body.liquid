    {
      "type": "text",
      "id": "cta_bullet_2",
      "label": "Bullet 2",
      "default": "International Standard Quality Equipment"
    },
    {
      "type": "text",
      "id": "cta_bullet_3",
      "label": "Bullet 3",
      "default": "Installation and After-sales Service"
    },
    {
      "type": "text",
      "id": "cta_button_text",
      "label": "Button text",
      "default": "View Our Services"
    },
    {
      "type": "url",
