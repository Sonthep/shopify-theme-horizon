          var titleText = isThai ? 'เครื่องล้างจานแบบยกฝา Colged SteelTech 38-00 (Rack 500x500mm)' : 'Colged SteelTech 38-00 (Hood Type Dishwasher 500x500mm)';
          var btnText = isThai ? 'ดูรายละเอียดสินค้า / ขอใบเสนอราคา' : 'Explore Colged SteelTech 38-00 & Request Quote';
          var callText = '02-423-7575';

          var spec1Label = isThai ? 'ขนาดกะบะ:' : 'Rack:';
          var spec1Val = isThai ? '500 x 500 มม.' : '500 x 500 mm';
          var spec2Label = isThai ? 'ความเร็ว:' : 'Speed:';
          var spec2Val = isThai ? 'สูงสุด 60 แร็ค/ชม.' : 'Up to 60 Racks/hr';
          var spec3Label = isThai ? 'ประหยัด:' : 'Eco:';
          var spec3Val = isThai ? 'ระบบล้างน้ำอัจฉริยะ' : 'Water-Saving Rinse';
          var spec4Label = isThai ? 'บริการ:' : 'Service:';
          var spec4Val = isThai ? 'ทีมช่างดูแลทั่วประเทศ' : '24/7 Nationwide';

          var brandBadgeHtml = '';
          if (colgedLogoUrl) {
            brandBadgeHtml = '<a href="/collections/colged" class="article-product-card__brand-link js-product-card-vendor-link" target="_blank" rel="noopener" title="View Colged Collection">' +
                '<img class="article-product-card__brand-logo js-product-card-brand-logo" src="' + colgedLogoUrl + '" alt="' + vendorText + '" loading="lazy" onerror="this.style.display=\'none\'; this.nextElementSibling.style.display=\'inline-flex\';">' +
                '<span class="article-product-card__vendor" style="display:none;"><span>' + vendorText + '</span> <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg></span>' +
              '</a>';
          } else {
            brandBadgeHtml = '<a href="/collections/colged" class="article-product-card__vendor js-product-card-vendor js-product-card-vendor-link" target="_blank" rel="noopener" title="View Colged Collection">' +
                '<span>' + vendorText + '</span>' +
                '<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>' +
              '</a>';
          }

          var card = document.createElement('div');
          card.className = 'article-product-card';
          card.innerHTML = '<div class="article-product-card__media">' +
              '<span class="article-product-card__badge">' + badgeText + '</span>' +
              '<img class="article-product-card__img js-product-card-img" src="" alt="' + titleText + '" loading="lazy" style="display:none;">' +
              '<div class="article-product-card__placeholder js-product-card-placeholder" style="display:flex;flex-direction:column;align-items:center;justify-content:center;color:#1F6B4D;gap:8px;">' +
                '<svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/><circle cx="15" cy="15" r="2"/></svg>' +
                '<span style="font-size:11px;font-weight:700;letter-spacing:0.05em;text-transform:uppercase;color:#123B2B;">COLGED HOOD DISHWASHER</span>' +
              '</div>' +
            '</div>' +
            '<div class="article-product-card__info">' +
              '<div class="article-product-card__meta-top">' +
                brandBadgeHtml +
                '<span class="article-product-card__status">' +
                  '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>' +
                  '<span>' + statusText + '</span>' +
                '</span>' +
              '</div>' +
              '<h3 class="article-product-card__title">' +
                '<a href="' + targetUrl + '" class="js-product-card-title" target="_blank" rel="noopener">' + titleText + '</a>' +
              '</h3>' +
              '<p class="article-product-card__desc">' + cleanText + '</p>' +
              '<div class="article-product-card__specs">' +
                '<div class="article-product-spec">' +
                  '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>' +
                  '<span>' + spec1Label + ' <strong>' + spec1Val + '</strong></span>' +
                '</div>' +
                '<div class="article-product-spec">' +
                  '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>' +
                  '<span>' + spec2Label + ' <strong>' + spec2Val + '</strong></span>' +
                '</div>' +
                '<div class="article-product-spec">' +
                  '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg>' +
                  '<span>' + spec3Label + ' <strong>' + spec3Val + '</strong></span>' +
                '</div>' +
                '<div class="article-product-spec">' +
                  '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>' +
                  '<span>' + spec4Label + ' <strong>' + spec4Val + '</strong></span>' +
