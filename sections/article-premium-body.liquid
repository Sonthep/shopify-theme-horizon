      "label": "Button 1 Link"
    },
    {
      "type": "text",
      "id": "bottom_cta_btn_2_text",
      "label": "Button 2 Text",
      "default": "Consult a Specialist Free"
    },
    {
      "type": "url",
      "id": "bottom_cta_btn_2_link",
      "label": "Button 2 Link"
    },
    {
      "type": "image_picker",
      "id": "bottom_cta_image",
      "label": "Bottom CTA Image"
    }
  ],
  "blocks": [
    {
      "type": "quote_form",
      "name": "Quote Form",
      "limit": 1
    },
    {
      "type": "recommended_products",
      "name": "Recommended Products",
      "limit": 1,
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    },
    {
