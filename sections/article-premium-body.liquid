
{%- liquid
  assign reading_speed = 200
  assign word_count = article.content | strip_html | split: ' ' | size
  assign read_time = word_count | divided_by: reading_speed | plus: 1
  assign share_url = request.origin | append: article.url
  assign share_title = article.title | url_encode
-%}

<div class="article-body color-{{ section.settings.color_scheme }} spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}">
  <div class="section">
    <div class="article-layout__grid">

      {%- comment -%} ── LEFT SIDEBAR ── {%- endcomment -%}
      <aside class="article-sidebar article-sidebar--left" aria-label="Left sidebar">
        
        {%- comment -%} 1. Sticky TOC {%- endcomment -%}
        {%- if section.settings.show_toc -%}
          <div class="article-sidebar-card article-toc article-toc--sidebar" id="article-toc-sidebar" style="display:none" aria-label="Table of contents">
            <div class="article-toc__header">
              <h3 class="article-toc__title" style="font-size: 16px; font-weight: 700; color: #1a1a1a; margin: 0 0 16px 0;">สารบัญในบทความ</h3>
            </div>
            <div class="article-toc__content">
              <ol class="article-toc__list" id="article-toc-list-sidebar"></ol>
            </div>
          </div>
        {%- endif -%}

        {%- comment -%} 2. Promo CTA {%- endcomment -%}
        {%- if section.settings.show_cta -%}
          <div class="article-sidebar-cta" style="background-color: #FAFAFA; border: 1px solid #EEEEEE; border-radius: 8px; padding: 24px 20px; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 12px;">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#D31225" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 18v-6a9 9 0 0 1 18 0v6"></path>
              <path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"></path>
              <path d="M12 21v-4"></path>
              <path d="M8 21h8"></path>
            </svg>
            <h3 class="article-sidebar-cta__title" style="font-size: 16px; font-weight: 700; color: #1a1a1a; margin: 0;">{{ section.settings.cta_title | default: 'Consult a Specialist Free!' }}</h3>
            <p style="font-size: 12px; color: #666666; margin: 0; line-height: 1.4;">{{ section.settings.cta_bullet_1 | default: 'We help recommend the right commercial dishwasher for your business.' }}</p>
            {%- if section.settings.cta_button_link != blank -%}
              <a href="{{ section.settings.cta_button_link }}" style="background-color: #D31225; color: #ffffff; text-decoration: none; font-size: 14px; font-weight: 600; padding: 10px 24px; border-radius: 6px; width: 100%; display: flex; align-items: center; justify-content: center; gap: 6px; margin-top: 8px; transition: background-color 0.2s;">
                {{ section.settings.cta_button_text | default: 'Consult Now' }}
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}

      </aside>

      {%- comment -%} ── MAIN COLUMN ── {%- endcomment -%}
      <article class="article-body__main" id="article-content">
        
        {%- comment -%} Breadcrumb {%- endcomment -%}
        <nav class="article-main__breadcrumb" aria-label="Breadcrumb">
          <a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t }}</a>
          <span aria-hidden="true">›</span>
          {%- if article.blog != blank -%}
            <a href="{{ article.blog.url }}">{{ article.blog.title }}</a>
            <span aria-hidden="true">›</span>
          {%- endif -%}
          <span aria-current="page">{{ article.title | truncate: 40 }}</span>
        </nav>

        {%- comment -%} Tags {%- endcomment -%}
        {%- if article.tags.size > 0 and section.settings.show_tags -%}
          <div class="article-main__tags">
            {%- for tag in article.tags limit: 3 -%}
              <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="article-main__tag">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
                {{ tag }}
              </a>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- comment -%} Title {%- endcomment -%}
        <h1 class="article-main__title">{{ article.title }}</h1>

        {%- comment -%} Meta {%- endcomment -%}
        <div class="article-main__meta">
          {%- if section.settings.show_date -%}
            <div class="article-main__meta-item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                {{ article.published_at | date: '%d %B %Y' }}
              </time>
            </div>
          {%- endif -%}

          {%- if section.settings.show_read_time -%}
            <div class="article-main__meta-item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              <span>{{ read_time }} min read</span>
            </div>
          {%- endif -%}

          {%- if section.settings.show_author_card and article.author != blank -%}
            <div class="article-main__meta-item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              <span>By {{ article.author }}</span>
            </div>
          {%- endif -%}
        </div>

        {%- comment -%} Featured Image {%- endcomment -%}
        {%- if article.image -%}
          <div class="article-main__media">
            {{
              article.image
              | image_url: width: 1000
              | image_tag: loading: 'eager', class: 'article-main__image'
            }}
          </div>
        {%- endif -%}

        {%- comment -%} Excerpt / lead {%- endcomment -%}
        {%- if article.excerpt != blank and section.settings.show_excerpt -%}
          <p class="article-body__excerpt">{{ article.excerpt | strip_html }}</p>
        {%- endif -%}

        {%- comment -%} Table of Contents (inline, for mobile) {%- endcomment -%}
        {%- if section.settings.show_toc -%}
          <div class="article-toc article-toc--inline" id="article-toc-inline" aria-label="Table of contents" style="display:none">
            <div class="article-toc__header">
              <h3 class="article-toc__title" style="font-size: 16px; font-weight: 700; color: #1a1a1a; margin: 0 0 16px 0;">สารบัญในบทความ</h3>
            </div>
            <div class="article-toc__content">
              <ol class="article-toc__list" id="article-toc-list-inline"></ol>
            </div>
          </div>
        {%- endif -%}

        {%- comment -%} Body content {%- endcomment -%}
        <div class="article-body__rte rte" id="article-rte">
          {{ article.content }}
        </div>

        {%- comment -%} Tags footer {%- endcomment -%}
        {%- if article.tags.size > 0 and section.settings.show_sidebar_tags -%}
          <div class="article-body__tag-footer">
            {%- for tag in article.tags -%}
              <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="article-body__tag">{{ tag }}</a>
            {%- endfor -%}
          </div>
        {%- endif -%}
        
        {%- comment -%} Share bar {%- endcomment -%}
        {%- if section.settings.show_share_sidebar -%}
          <div class="article-sidebar-card article-sidebar-share article-sidebar-share--mobile">
            <h3 class="article-sidebar-card__title">Share this article</h3>
            <div class="article-sidebar-share__buttons">
              <a href="https://www.facebook.com/sharer/sharer.php?u={{ share_url | url_encode }}" target="_blank" rel="noopener" class="sidebar-share-btn sidebar-share-btn--facebook" aria-label="Share on Facebook">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
              </a>
              <a href="https://social-plugins.line.me/lineit/share?url={{ share_url | url_encode }}" target="_blank" rel="noopener" class="sidebar-share-btn sidebar-share-btn--line" aria-label="Share on LINE">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M22.5 10.5c0-4.6-4.7-8.3-10.5-8.3S1.5 5.9 1.5 10.5c0 4.1 3.7 7.7 8.6 8.2.3 0 .9.2 1 .7.1.4-.1.9-.2 1.4l-.3 1c-.1.3-.2 1.1.9 1.5.8.3 2-.1 3.2-1.2 1.4-1.3 4.2-4.1 5.4-5.6 1.6-1.7 2.4-3.6 2.4-6z"/></svg>
              </a>
              <a href="https://www.linkedin.com/shareArticle?mini=true&url={{ share_url | url_encode }}&title={{ share_title }}" target="_blank" rel="noopener" class="sidebar-share-btn sidebar-share-btn--linkedin" aria-label="Share on LinkedIn">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
              </a>
              <button class="sidebar-share-btn sidebar-share-btn--copy" id="copy-link-btn" aria-label="Copy link" data-url="{{ share_url | escape }}">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
              </button>
            </div>
          </div>
        {%- endif -%}

      {%- comment -%} Bottom CTA {%- endcomment -%}
      {%- if section.settings.show_bottom_cta -%}
        <div class="article-bottom-cta" style="margin-top: 60px; padding: 40px; background-color: #FAFAFA; border: 1px solid #EEEEEE; border-radius: 12px; display: flex; align-items: center; justify-content: space-between; gap: 40px; position: relative; overflow: hidden;">
          <div style="flex: 1; position: relative; z-index: 2;">
            <h3 style="font-size: 24px; font-weight: 700; color: #1a1a1a; margin-bottom: 8px; line-height: 1.3;">{{ section.settings.bottom_cta_title | default: 'Let Sevenfive help you choose the best for your business' }}</h3>
            <p style="font-size: 14px; color: #666666; margin-bottom: 24px;">{{ section.settings.bottom_cta_text | default: 'Kitchen design, equipment installation, full service — all in one place' }}</p>
            <div style="display: flex; gap: 12px; flex-wrap: wrap;">
              <a href="{{ section.settings.bottom_cta_btn_1_link }}" style="background-color: #D31225; color: #ffffff; padding: 12px 24px; border-radius: 6px; font-size: 14px; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: background-color 0.2s;">
                {{ section.settings.bottom_cta_btn_1_text | default: 'Request a Quote' }}
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
              </a>
              <a href="{{ section.settings.bottom_cta_btn_2_link }}" style="background-color: #ffffff; color: #1a1a1a; border: 1px solid #cccccc; padding: 12px 24px; border-radius: 6px; font-size: 14px; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: background-color 0.2s;">
                {{ section.settings.bottom_cta_btn_2_text | default: 'Consult a Specialist Free' }}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 18v-6a9 9 0 0 1 18 0v6"></path><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"></path></svg>
              </a>
            </div>
          </div>
          {%- if section.settings.bottom_cta_image != blank -%}
            <div style="width: 200px; flex-shrink: 0; position: relative; z-index: 1;">
              {{ section.settings.bottom_cta_image | image_url: width: 400 | image_tag: loading: 'lazy', style: 'width: 100%; height: auto; display: block;' }}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      </article>

      {%- comment -%} ── RIGHT SIDEBAR ── {%- endcomment -%}
      <aside class="article-sidebar article-sidebar--right" aria-label="Right sidebar">
        
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            
            {%- when 'quote_form' -%}
              <div class="article-sidebar-card article-quote-form" style="background-color: #FAFAFA; border: 1px solid #EEEEEE; border-radius: 8px; padding: 24px;" {{ block.shopify_attributes }}>
                <h3 class="article-sidebar-card__title" style="color: #1a1a1a; font-size: 16px; font-weight: 700; margin-bottom: 8px;">Request a Quote</h3>
                <p style="color: #666666; font-size: 12px; margin-bottom: 16px; line-height: 1.4;">Get a special offer tailored for you</p>
                
                <ul style="list-style: none; padding: 0; margin: 0 0 20px 0; display: flex; flex-direction: column; gap: 8px;">
                  <li style="display: flex; align-items: flex-start; gap: 8px; font-size: 13px; color: #1a1a1a;"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#D31225" stroke-width="2" style="flex-shrink: 0; margin-top: 2px;"><polyline points="20 6 9 17 4 12"></polyline></svg> Free! On-site Assessment</li>
                  <li style="display: flex; align-items: flex-start; gap: 8px; font-size: 13px; color: #1a1a1a;"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#D31225" stroke-width="2" style="flex-shrink: 0; margin-top: 2px;"><polyline points="20 6 9 17 4 12"></polyline></svg> Free! 3D Design</li>
                  <li style="display: flex; align-items: flex-start; gap: 8px; font-size: 13px; color: #1a1a1a;"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#D31225" stroke-width="2" style="flex-shrink: 0; margin-top: 2px;"><polyline points="20 6 9 17 4 12"></polyline></svg> Free! Kitchen Planning Consultation</li>
                </ul>

                {%- form 'contact', id: 'article-quote-form' -%}
                  {%- if form.posted_successfully? -%}
                    <p class="form-success" style="color: #D31225; font-size: 13px;">Thank you! Our team will contact you shortly.</p>
                  {%- else -%}
                    <div class="form-fields" style="display: flex; flex-direction: column; gap: 0;">
                      <button type="submit" style="background: #D31225; color: #ffffff; font-weight: 600; font-size: 13px; padding: 12px; border: none; border-radius: 4px; cursor: pointer; width: 100%; display: flex; align-items: center; justify-content: center; gap: 6px; transition: opacity 0.2s;" onmouseover="this.style.opacity=0.9" onmouseout="this.style.opacity=1">
                        Get a Quote Now <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
                      </button>
                    </div>
                  {%- endif -%}
                {%- endform -%}
              </div>
              
            {%- when 'recommended_products' -%}
              <div class="article-sidebar-card article-recommended-products" style="background-color: #FFFFFF; border: 1px solid #EEEEEE; border-radius: 8px; padding: 24px;" {{ block.shopify_attributes }}>
                <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 16px;">
                  <h3 class="article-sidebar-card__title" style="color: #1a1a1a; font-size: 16px; font-weight: 700; margin: 0;">Recommended Products</h3>
                  <a href="{{ collections[block.settings.collection].url | default: '/collections/all' }}" style="font-size: 12px; color: #666666; text-decoration: none;">View All</a>
                </div>
                <div class="article-recommended__list" style="display:flex; flex-direction:column; gap:16px;">
                  {%- assign collection = collections[block.settings.collection] -%}
                  {%- if collection != blank -%}
                    {%- for product in collection.products limit: 3 -%}
                      <a href="{{ product.url }}" class="article-recommended__item" style="display:flex; gap:12px; text-decoration:none; padding-bottom:16px; border-bottom: 1px solid #F3F8F5;">
                        <div class="article-recommended__thumb" style="width: 64px; height: 64px; border-radius:8px; overflow:hidden; background:#F9F9F9; border: 1px solid #EEEEEE; flex-shrink:0;">
                          {{ product.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', style: 'width:100%; height:100%; object-fit:contain;' }}
                        </div>
                        <div class="article-recommended__info" style="display:flex; flex-direction:column; justify-content:center; gap:4px; flex:1;">
                          <span class="article-recommended__title" style="font-size:13px; font-weight:600; color:#1a1a1a; line-height:1.3;">{{ product.title }}</span>
                          <span class="article-recommended__desc" style="font-size:12px; font-weight:600; color:#666666;">Starting at {{ product.price | money_without_trailing_zeros }}</span>
                        </div>
                      </a>
                    {%- endfor -%}
                  {%- else -%}
                    <p style="font-size:13px; color:#5E6A63;">Select a collection to show products.</p>
                  {%- endif -%}
                </div>
              </div>
            {%- when 'download_brochure' -%}
              <div class="article-sidebar-card article-brochure-download" style="background-color: #1a1a1a; border-radius: 8px; padding: 24px; color: #ffffff; display: flex; flex-direction: column; gap: 16px;" {{ block.shopify_attributes }}>
                <div>
                  <h3 class="article-sidebar-card__title" style="color: #ffffff; font-size: 16px; font-weight: 700; margin: 0 0 6px 0;">Download<br>Brochure</h3>
                  <p style="color: #cccccc; font-size: 12px; margin: 0; line-height: 1.4;">Get the latest product catalogs<br>from Sevenfive</p>
                </div>
                
                <div style="display: flex; justify-content: center; align-items: flex-end; padding: 12px 0 0 0; position: relative; min-height: 120px;">
                  {%- if block.settings.image != blank -%}
                    {{ block.settings.image | image_url: width: 300 | image_tag: loading: 'lazy', style: 'width: auto; height: 110px; object-fit: contain; box-shadow: 0 4px 10px rgba(0,0,0,0.3); border-radius: 4px;' }}
                  {%- else -%}
                    {%- comment -%} Placeholder brochure look {%- endcomment -%}
                    <div style="width: 80px; height: 110px; background: #333; border: 1px solid #444; border-radius: 4px; box-shadow: 0 4px 10px rgba(0,0,0,0.3); transform: rotate(-5deg) translateX(15px); display: flex; align-items: center; justify-content: center;"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#D31225" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg></div>
                    <div style="width: 80px; height: 110px; background: #D31225; border-radius: 4px; box-shadow: 0 6px 12px rgba(0,0,0,0.4); transform: rotate(5deg) translateX(-15px); display: flex; flex-direction: column; align-items: center; justify-content: center; z-index: 2; padding: 8px; box-sizing: border-box;">
                      <div style="font-size: 8px; font-weight: bold; color: #fff; text-align: center; line-height: 1.2;">SEVENFIVE</div>
                      <div style="width: 100%; height: 1px; background: rgba(255,255,255,0.3); margin: 6px 0;"></div>
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                    </div>
                  {%- endif -%}
                </div>

                <a href="{{ block.settings.brochure_file | default: '#' }}" class="article-sidebar-cta__btn" style="display: flex; align-items: center; justify-content: center; gap: 8px; background: #ffffff; color: #1a1a1a; padding: 10px 16px; border-radius: 6px; font-size: 13px; font-weight: 600; text-decoration: none; width: 100%; text-align: center; margin-top: 8px; border: none; box-sizing: border-box; transition: background 0.2s;" onmouseover="this.style.background='#f0f0f0'" onmouseout="this.style.background='#ffffff'">
                  Download Now
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                </a>
              </div>

          {%- endcase -%}
        {%- endfor -%}

        {%- comment -%} Related posts {%- endcomment -%}
        {%- if section.settings.show_related and blog.articles_count > 1 -%}
          <div class="article-sidebar-card article-related" style="background-color: #FFFFFF; border: 1px solid #EEEEEE; border-radius: 8px; padding: 24px;">
            <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 16px;">
              <h3 class="article-sidebar-card__title" style="color: #1a1a1a; font-size: 16px; font-weight: 700; margin: 0;">Related Articles</h3>
              <a href="{{ blog.url }}" style="font-size: 12px; color: #666666; text-decoration: none;">View All</a>
            </div>
            <div class="article-related__list">
              {%- assign count = 0 -%}
              {%- for related in blog.articles -%}
                {%- unless related.id == article.id -%}
                  {%- if count < 4 -%}
                    <a href="{{ related.url }}" class="article-related__item" style="display: flex; gap: 12px; align-items: flex-start; text-decoration: none; padding: 12px 0; border-bottom: 1px solid #F9F9F9;">
                      {%- if related.image -%}
                        <div class="article-related__thumb" style="flex-shrink: 0; width: 64px; height: 64px; border-radius: 8px; overflow: hidden; background: #F9F9F9; border: 1px solid #EEEEEE;">
                          {{ related.image | image_url: width: 160 | image_tag: loading: 'lazy', style: 'width:100%; height:100%; object-fit:cover;' }}
                        </div>
                      {%- else -%}
                        <div class="article-related__thumb article-related__thumb--placeholder" style="flex-shrink: 0; width: 64px; height: 64px; border-radius: 8px; overflow: hidden; background: #F9F9F9; border: 1px solid #EEEEEE; display: flex; align-items: center; justify-content: center; color: #cccccc;">
