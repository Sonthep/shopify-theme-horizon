
{%- liquid
  assign reading_speed = 200
  assign word_count = article.content | strip_html | split: ' ' | size
  assign read_time = word_count | divided_by: reading_speed | plus: 1
-%}

<div class="article-hero color-{{ section.settings.color_scheme }} spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}">

  {%- if article.image -%}
    <div class="article-hero__media">
      {{
        article.image
        | image_url: width: 1800
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          class: 'article-hero__image',
          widths: '640,768,1024,1280,1440,1800',
          sizes: '100vw'
      }}
      <div class="article-hero__overlay"></div>
    </div>
  {%- else -%}
    <div class="article-hero__media article-hero__media--no-image">
      <div class="article-hero__overlay article-hero__overlay--solid"></div>
    </div>
  {%- endif -%}

  <div class="section">
    <div class="article-hero__content">

      {%- comment -%} Breadcrumb {%- endcomment -%}
    <nav class="article-hero__breadcrumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t }}</a>
      <span aria-hidden="true">›</span>
      {%- if article.blog != blank -%}
        <a href="{{ article.blog.url }}">{{ article.blog.title }}</a>
        <span aria-hidden="true">›</span>
      {%- endif -%}
      <span aria-current="page">{{ article.title | truncate: 40 }}</span>
    </nav>

    {%- comment -%} Tags / Category {%- endcomment -%}
    {%- if article.tags.size > 0 and section.settings.show_tags -%}
      <div class="article-hero__tags">
        {%- for tag in article.tags limit: 3 -%}
          <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="article-hero__tag">
            {{ tag }}
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%} Title {%- endcomment -%}
    <h1 class="article-hero__title">{{ article.title }}</h1>

    {%- comment -%} Meta row {%- endcomment -%}
    <div class="article-hero__meta">
      {%- if section.settings.show_author and article.author != blank -%}
        <div class="article-hero__meta-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
          </svg>
          <span>{{ article.author }}</span>
        </div>
      {%- endif -%}

      {%- if section.settings.show_date -%}
        <div class="article-hero__meta-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
            <line x1="16" y1="2" x2="16" y2="6"/>
            <line x1="8" y1="2" x2="8" y2="6"/>
            <line x1="3" y1="10" x2="21" y2="10"/>
          </svg>
          <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
            {{ article.published_at | date: '%d %B %Y' }}
          </time>
        </div>
      {%- endif -%}

      {%- if section.settings.show_read_time -%}
        <div class="article-hero__meta-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12 6 12 12 16 14"/>
          </svg>
          <span>{{ read_time }} min read</span>
        </div>
      {%- endif -%}
    </div>

    </div>
  </div>
</div>

{% stylesheet %}
  .article-hero {
    position: relative;
    min-height: 480px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  .article-hero--no-image {
    min-height: 320px;
    background-color: #1F6B4D;
  }

  .article-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .article-hero__media--no-image {
    background: linear-gradient(135deg, #123B2B 0%, #1F6B4D 60%, #17553D 100%);
  }

  .article-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .article-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(18, 59, 43, 0.90) 0%,
      rgba(18, 59, 43, 0.60) 40%,
      rgba(18, 59, 43, 0.20) 100%
    );
  }

  .article-hero__overlay--solid {
    background: transparent;
  }

  .article-hero__content {
    position: relative;
    z-index: 1;
    padding-block-start: 80px;
    padding-block-end: 56px;
    width: 100%;
    max-width: 860px;
  }

  .article-hero__breadcrumb {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.75);
    margin-bottom: 20px;
  }

  .article-hero__breadcrumb a {
    color: rgba(255, 255, 255, 0.75);
    text-decoration: none;
    transition: color 0.2s;
  }

  .article-hero__breadcrumb a:hover {
    color: #ffffff;
  }

  .article-hero__breadcrumb span[aria-current] {
    color: rgba(255, 255, 255, 0.55);
  }

  .article-hero__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 16px;
  }

  .article-hero__tag {
    display: inline-block;
    padding: 4px 12px;
    background-color: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.30);
    border-radius: 100px;
    color: #ffffff;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.2s, border-color 0.2s;
    backdrop-filter: blur(4px);
  }

  .article-hero__tag:hover {
    background-color: rgba(255, 255, 255, 0.25);
    border-color: rgba(255, 255, 255, 0.50);
  }

  .article-hero__title {
    font-size: clamp(28px, 4vw, 48px);
    font-weight: 600;
    line-height: 1.18;
    color: #ffffff;
    margin: 0 0 24px;
    text-wrap: pretty;
  }

  .article-hero__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
  }

  .article-hero__meta-item {
    display: flex;
    align-items: center;
    gap: 6px;
    color: rgba(255, 255, 255, 0.80);
    font-size: 14px;
  }

  .article-hero__meta-item svg {
    flex-shrink: 0;
  }

  @media screen and (max-width: 768px) {
    .article-hero {
      min-height: 360px;
    }

    .article-hero__content {
      padding-block-start: 48px;
      padding-block-end: 40px;
    }

    .article-hero__title {
      font-size: 26px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Article Hero",
  "tag": "section",
  "class": "section-wrapper article-hero-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "Show tags",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show author",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_read_time",
      "label": "Show reading time",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Article Hero"
    }
  ]
}
{% endschema %}
