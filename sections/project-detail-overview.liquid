{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .project-detail-overview {
    background-color: #FFFFFF;
  }

  .project-detail-overview__inner {
    max-width: var(--page-width, 1440px);
    margin: 0 auto;
    padding-left: 2rem;
    padding-right: 2rem;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  @media screen and (min-width: 990px) {
    .project-detail-overview__inner {
      flex-direction: row;
      gap: 96px;
    }
  }

  .project-detail-overview__column {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .project-detail-overview__heading {
    font-size: 24px;
    line-height: 32px;
    font-weight: 600;
    color: #123B2B;
    margin: 0;
    font-family: var(--font-heading-family);
  }

  @media screen and (min-width: 750px) {
    .project-detail-overview__heading {
      font-size: 32px;
      line-height: 40px;
    }
  }

  .project-detail-overview__text {
    font-size: 16px;
    line-height: 24px;
    color: #5E6A63;
    margin: 0;
  }

  .project-detail-overview__text p {
    margin-top: 0;
    margin-bottom: 16px;
  }

  .project-detail-overview__text p:last-child {
    margin-bottom: 0;
  }
{%- endstyle -%}

<div class="project-detail-overview section-{{ section.id }}-padding">
  <div class="project-detail-overview__inner">
    
    {%- if section.settings.challenge_heading != blank or section.settings.challenge_text != blank -%}
      <div class="project-detail-overview__column">
        {%- if section.settings.challenge_heading != blank -%}
          <h2 class="project-detail-overview__heading">{{ section.settings.challenge_heading }}</h2>
        {%- endif -%}
        {%- if section.settings.challenge_text != blank -%}
          <div class="project-detail-overview__text">
            {{ section.settings.challenge_text }}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.solution_heading != blank or section.settings.solution_text != blank -%}
      <div class="project-detail-overview__column">
        {%- if section.settings.solution_heading != blank -%}
          <h2 class="project-detail-overview__heading">{{ section.settings.solution_heading }}</h2>
        {%- endif -%}
        {%- if section.settings.solution_text != blank -%}
          <div class="project-detail-overview__text">
            {{ section.settings.solution_text }}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Project Overview",
  "settings": [
    {
      "type": "text",
      "id": "challenge_heading",
      "label": "Challenge Heading",
      "default": "The Challenge"
    },
    {
      "type": "richtext",
      "id": "challenge_text",
      "label": "Challenge Text",
      "default": "<p>Describe the client's needs, constraints, and the primary challenge of the project.</p>"
    },
    {
      "type": "text",
      "id": "solution_heading",
      "label": "Solution Heading",
      "default": "Our Solution"
    },
    {
      "type": "richtext",
      "id": "solution_text",
      "label": "Solution Text",
      "default": "<p>Explain how Seven Five approached the challenge, the equipment selected, and the outcome.</p>"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Project Overview"
    }
  ]
}
{% endschema %}
