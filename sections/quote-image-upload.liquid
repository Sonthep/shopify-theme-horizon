{% comment %}
  Section contract.
  Lets signed-in customers upload a Seven Five quotation PDF and download it back
  with product images inserted. The quotation app proxy matches products and
  renders the file in one step; there is no review or editing.
  @example
  <!-- Add the "Quotation images" section to a page template, e.g. page.quotation-images -->
{% endcomment %}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--{{ section.settings.section_width }} spacing-style color-{{ section.settings.color_scheme }}"
  style="{% render 'spacing-padding', settings: section.settings %}"
>
  <div class="quote-image-upload">
    {%- if section.settings.heading != blank -%}
      <h2 class="quote-image-upload__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="quote-image-upload__text rte">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- if customer -%}
      <script
        type="module"
        src="{{ 'quote-image-upload.js' | asset_url }}"
      ></script>

      <quote-image-upload
        class="quote-image-upload__form"
        data-endpoint="/apps/quotation/quote-images"
        data-max-bytes="10485760"
        data-message-preparing="{{ 'content.quote_images_preparing' | t }}"
        data-message-ready="{{ 'content.quote_images_ready' | t: count: '[count]' }}"
        data-message-ready-none="{{ 'content.quote_images_ready_none' | t }}"
        data-message-error="{{ 'content.quote_images_error' | t }}"
        data-message-error-file="{{ 'content.quote_images_error_file' | t }}"
        data-message-error-size="{{ 'content.quote_images_error_size' | t }}"
        data-message-error-login="{{ 'content.cart_quote_error_login' | t }}"
        data-message-error-rate="{{ 'content.cart_quote_error_rate' | t }}"
      >
        <label
          class="quote-image-upload__label"
          for="QuoteImageFile-{{ section.id }}"
        >
          {{- 'content.quote_images_choose' | t -}}
        </label>
        <input
          id="QuoteImageFile-{{ section.id }}"
          class="quote-image-upload__input"
          type="file"
          accept="application/pdf,.pdf"
          ref="file"
          on:change="/clearStatus"
        >
        <button
          type="button"
          class="button quote-image-upload__button"
          ref="button"
          on:click="/upload"
        >
          {{ 'content.quote_images_submit' | t }}
        </button>
        <p
          class="quote-image-upload__status"
          ref="status"
          role="status"
        ></p>
        <div
          class="quote-image-upload__preview"
          ref="preview"
          hidden
        >
          <div class="quote-image-upload__actions">
            <a
              class="button quote-image-upload__button"
              ref="downloadLink"
              href="#"
            >
              {{- 'content.quote_images_download' | t -}}
            </a>
            <a
              class="button button-secondary quote-image-upload__button"
              ref="openLink"
              href="#"
              target="_blank"
              rel="noopener"
            >
              {{- 'content.quote_images_open' | t -}}
            </a>
          </div>
          <iframe
            class="quote-image-upload__frame"
            ref="frame"
            title="{{ 'content.quote_images_preview_title' | t }}"
          ></iframe>
        </div>
      </quote-image-upload>
    {%- elsif shop.customer_accounts_enabled -%}
      {%- assign login_url = routes.account_login_url | append: '?return_url=' | append: request.path -%}
      <a
        href="{{ login_url }}"
        class="button quote-image-upload__button"
      >
        {{ 'content.quote_images_login' | t }}
      </a>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .quote-image-upload {
    display: grid;
    gap: var(--gap-md);
    max-width: 60rem;
    min-width: 0;
    margin-inline: auto;
    text-align: center;
  }

  .quote-image-upload__heading,
  .quote-image-upload__text {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .quote-image-upload__form {
    display: grid;
    gap: var(--gap-sm);
    justify-items: center;
    min-width: 0;
  }

  .quote-image-upload__label {
    font-weight: var(--font-weight-bold, 700);
  }

  .quote-image-upload__input {
    max-width: 100%;
  }

  .quote-image-upload__button {
    justify-self: center;
  }

  .quote-image-upload__button[aria-busy='true'] {
    cursor: progress;
  }

  .quote-image-upload__status {
    margin: 0;
    overflow-wrap: anywhere;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
  }

  .quote-image-upload__status:empty {
    display: none;
  }

  .quote-image-upload__preview {
    display: grid;
    gap: var(--gap-sm);
    justify-self: stretch;
    min-width: 0;
  }

  .quote-image-upload__preview[hidden] {
    display: none;
  }

  .quote-image-upload__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-sm);
    justify-content: center;
  }

  .quote-image-upload__frame {
    inline-size: 100%;
    block-size: min(80vh, 60rem);
    border: var(--style-border-width) solid rgb(var(--color-foreground-rgb) / var(--opacity-10));
    background: var(--color-background);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.quote_image_upload",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Add product images to your quotation"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:settings.text",
      "default": "<p>Upload the PDF quotation you received from Seven Five. We'll add product photos and send the file straight back.</p>"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "t:names.quote_image_upload",
      "category": "t:categories.forms"
    }
  ]
}
{% endschema %}
